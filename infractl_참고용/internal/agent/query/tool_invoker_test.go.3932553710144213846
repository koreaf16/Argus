func TestToolInvokerBlocksRepeatedPrivilegePromptFailureWithPrivilegeArgs(t *testing.T) {
	baseCalls := 0
	ti := NewToolInvoker(nil, func(_ context.Context, _ llm.ToolCall) (string, bool) {
		baseCalls++
		return "Failed to move file to final destination via sudo (exit=0): no privilege prompt handler available\nLocal file was verified and uploaded to staging path /tmp/.infractl/staging/db.zip; only the privileged final copy to /home/oracle/db.zip failed.", true
	})

	args := `{"action":"upload","local_path":"db.zip","remote_path":"/home/oracle/db.zip","become_user":"oracle","become_method":"sudo","description":"db zip upload"}`
	out, isErr := ti.Invoke(context.Background(), makeTC("file_transfer", args))
	if !isErr {
		t.Fatalf("expected first privilege prompt failure, got %q", out)
	}
	if baseCalls != 1 {
		t.Fatalf("expected first call to reach base, got %d", baseCalls)
	}

	out, isErr = ti.Invoke(context.Background(), makeTC("file_transfer", args))
	if !isErr {
		t.Fatalf("expected repeated privilege prompt failure to be blocked, got %q", out)
	}
	if baseCalls != 1 {
		t.Fatalf("repeated prompt failure should not reach base, got %d calls", baseCalls)
	}
	if !strings.Contains(out, "previous privilege prompt failure") {
		t.Fatalf("unexpected retry block message: %q", out)
	}
}

func TestToolInvoker_PreToolUseDenyCallsBlockedCallback(t *testing.T) {
	hooks.ResetSnapshot()
	defer hooks.ResetSnapshot()

	path := filepath.Join(t.TempDir(), "hooks.yaml")
	if err := os.WriteFile(path, []byte(`
PreToolUse:
  - matcher: "mutate"
    hooks:
      - type: unknown_backend
`), 0o600); err != nil {
		t.Fatalf("write hooks config: %v", err)
	}
	if err := hooks.CaptureSnapshot(path); err != nil {
		t.Fatalf("capture hooks snapshot: %v", err)
	}

	called := false
	blocked := false
	ti := NewToolInvoker(hooks.NewRunner(nil), func(_ context.Context, _ llm.ToolCall) (string, bool) {
		called = true
		return "should not run", false
	})
	ti.SetBlockedCallback(func(_ llm.ToolCall, reason string) {
		blocked = reason != ""
	})

	out, isErr := ti.Invoke(context.Background(), makeTC("mutate", `{}`))
	if !isErr {
		t.Fatalf("expected deny error, got output %q", out)
	}
	if called {
		t.Fatal("denied tool must not reach base runner")
	}
	if !blocked {
		t.Fatal("PreToolUse deny should call blocked callback")
	}
}

func TestToolInvoker_PreToolUseDenyCanBeTemporarilyApproved(t *testing.T) {
	hooks.ResetSnapshot()
	defer hooks.ResetSnapshot()

	path := filepath.Join(t.TempDir(), "hooks.yaml")
	if err := os.WriteFile(path, []byte(`
PreToolUse:
  - matcher: "mutate"
    hooks:
      - type: unknown_backend
`), 0o600); err != nil {
		t.Fatalf("write hooks config: %v", err)
	}
	if err := hooks.CaptureSnapshot(path); err != nil {
		t.Fatalf("capture hooks snapshot: %v", err)
	}

	baseCalls := 0
	promptCalls := 0
	ti := NewToolInvoker(hooks.NewRunner(nil), func(_ context.Context, _ llm.ToolCall) (string, bool) {
		baseCalls++
		return "ran", false
	})
	ti.SetHookApprovalPrompter(func(context.Context, tools.QuestionRequest) (tools.QuestionResponse, error) {
		promptCalls++
		return tools.QuestionResponse{SelectedIndex: 0, SelectedLabel: "Allow Temporarily"}, nil
	})

	out, isErr := ti.Invoke(context.Background(), makeTC("mutate", `{}`))
	if isErr {
		t.Fatalf("expected approved execution, got error output: %q", out)
	}
	if out != "ran" {
		t.Fatalf("unexpected output: %q", out)
	}
	if baseCalls != 1 {
		t.Fatalf("expected base runner call once, got %d", baseCalls)
	}
	if promptCalls != 1 {
		t.Fatalf("expected one prompt call, got %d", promptCalls)
	}

	out, isErr = ti.Invoke(context.Background(), makeTC("mutate", `{}`))
	if isErr {
		t.Fatalf("expected cached approval to keep allowing, got error output: %q", out)
	}
	if baseCalls != 2 {
		t.Fatalf("expected base runner called twice, got %d", baseCalls)
	}
	if promptCalls != 1 {
		t.Fatalf("expected no extra prompt after cache hit, got %d", promptCalls)
	}
}

