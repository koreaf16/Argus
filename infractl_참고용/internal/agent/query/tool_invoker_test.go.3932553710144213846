func TestToolInvokerBlocksSemanticPermissionRetry(t *testing.T) {
	baseCalls := 0
	ti := NewToolInvoker(nil, func(_ context.Context, _ llm.ToolCall) (string, bool) {
		baseCalls++
		return "mkdir: cannot create directory '/home/oracle/app': Permission denied", true
	})

	out, isErr := ti.Invoke(context.Background(), makeTC("shell_exec", `{"command":"mkdir -p /home/oracle/app"}`))
	if !isErr {
		t.Fatalf("expected first permission failure, got %q", out)
	}
	if baseCalls != 1 {
		t.Fatalf("expected first call to reach base, got %d", baseCalls)
	}

	out, isErr = ti.Invoke(context.Background(), makeTC("shell_exec", `{"command":"mkdir /home/oracle/app"}`))
	if !isErr {
		t.Fatalf("expected semantic retry block, got %q", out)
	}
	if baseCalls != 1 {
		t.Fatalf("semantic retry should not reach base, got %d calls", baseCalls)
	}
	if !strings.Contains(out, "same path/account class") {
		t.Fatalf("unexpected retry block message: %q", out)
	}
}

func TestToolInvokerAllowsPermissionRetryWithPrivilegeCorrection(t *testing.T) {
	baseCalls := 0
	ti := NewToolInvoker(nil, func(_ context.Context, _ llm.ToolCall) (string, bool) {
		baseCalls++
		return "mkdir: cannot create directory '/home/oracle/app': Permission denied", true
	})

	_, _ = ti.Invoke(context.Background(), makeTC("shell_exec", `{"command":"mkdir -p /home/oracle/app"}`))
	out, _ := ti.Invoke(context.Background(), makeTC("shell_exec", `{"command":"mkdir /home/oracle/app","become_method":"sudo","become_user":"oracle"}`))
	if baseCalls != 2 {
		t.Fatalf("privilege-corrected retry should reach base, got %d calls; out=%q", baseCalls, out)
	}
}

func TestToolInvokerAutoRoutesFileTransferOracleUpload(t *testing.T) {
	var got map[string]any
	ti := NewToolInvoker(nil, func(_ context.Context, tc llm.ToolCall) (string, bool) {
		if err := json.Unmarshal([]byte(tc.Function.Arguments), &got); err != nil {
			t.Fatalf("unmarshal routed args: %v", err)
		}
		return "ok", false
	})

	out, isErr := ti.Invoke(context.Background(), makeTC("file_transfer", `{"action":"upload","local_path":"db.zip","remote_path":"/home/oracle/db.zip","description":"db zip upload"}`))
	if isErr {
		t.Fatalf("expected success, got %q", out)
	}
	if got["become_user"] != "oracle" {
		t.Fatalf("become_user = %#v, want oracle; args=%v", got["become_user"], got)
	}
	if got["become_method"] != "sudo" {
		t.Fatalf("become_method = %#v, want sudo; args=%v", got["become_method"], got)
	}
}

