// claude_cli: queryLoop async function* (query.ts:241)
func (e *Engine) runLoop(ctx context.Context, p Params, out chan<- QueryEvent) {
	// JSONSchema 媛 ?덉쑝硫?structured_output_tool ?꾧뎄 ?뺤쓽 異붽?
	if p.JSONSchema != nil {
		found := false
		for _, td := range p.Tools {
			if td.Function.Name == tools.StructuredOutputToolName {
				found = true
				break
			}
		}
		if !found {
			p.Tools = append(p.Tools, llm.ToolDef{
				Type: "function",
				Function: llm.FunctionDef{
					Name:        tools.StructuredOutputToolName,
					Description: "Use this tool to submit your final response in a structured JSON format matching the schema.",
					Parameters:  p.JSONSchema,
				},
			})
		}
	}

	s := initialState(p.Messages)
	se := NewStreamingExecutor(0, e.bgManager) // MaxToolConcurrency() 湲곕낯媛??ъ슜

	for turn := 0; turn < p.MaxTurns; turn++ {
		if err := ctx.Err(); err != nil {
			sendDirect(out, EventTerminal{Reason: TerminalInterrupted})
			return
		}

		slog.Debug("query engine turn start",
			"turn", s.turnCount,
			"tier", p.Tier,
			"model", p.ModelName,
			"messages", len(s.messages),
		)

		if e.compact != nil {
			cs := &compact.State{
				Messages:                     s.messages,
				ContextWindow:                p.ContextWindow,
				SystemTokens:                 p.SystemTokens,
				HasAttemptedReactiveCompact:  s.hasAttemptedReactiveCompact,
				MaxOutputTokensRecoveryCount: s.maxOutputTokensRecoveryCount,
				MaxOutputTokensOverride:      s.maxOutputTokensOverride,
			}
			e.compact.Apply(ctx, cs)
			s.messages = cs.Messages
			s.hasAttemptedReactiveCompact = cs.HasAttemptedReactiveCompact
			s.maxOutputTokensRecoveryCount = cs.MaxOutputTokensRecoveryCount
			s.maxOutputTokensOverride = cs.MaxOutputTokensOverride
		}

		// 턴 경계 drain: compaction 직후, callLLM 직전에 pending 입력을 messages에 주입한다.
		s = drainPendingIntoState(ctx, p.PendingInput, s, out)

		done, nextState := e.runTurn(ctx, p, s, se, out)
		if done {
			return
		}
		s = nextState
	}

	slog.Warn("query engine max turns reached", "max_turns", p.MaxTurns)
	sendDirect(out, EventTerminal{Reason: TerminalMaxTurns, StructuredOutput: s.structuredOutput})
}

// runTurn ? ?⑥씪 LLM turn ???ㅽ뻾?쒕떎.
// done=true ?대㈃ Terminal ?대깽?멸? 諛⑹텧?섏뿀怨?猷⑦봽媛 醫낅즺?섏뼱???쒕떎.
func (e *Engine) runTurn(
	ctx context.Context,
	p Params,
	s state,
	se *StreamingExecutor,
	out chan<- QueryEvent,
) (done bool, next state) {
	if !send(ctx, out, EventStreamStart{Tier: string(p.Tier), Model: p.ModelName}) {
		sendDirect(out, EventTerminal{Reason: TerminalInterrupted, StructuredOutput: s.structuredOutput})
		return true, s
	}

	resp, err := e.callLLM(ctx, p, s, out)
	if err != nil {
		if ctx.Err() != nil {
			sendDirect(out, EventTerminal{Reason: TerminalInterrupted, StructuredOutput: s.structuredOutput})
			return true, s
		}

		if e.recovery != nil {
			cs := &compact.State{
				Messages:                     s.messages,
				ContextWindow:                p.ContextWindow,
				SystemTokens:                 p.SystemTokens,
				HasAttemptedReactiveCompact:  s.hasAttemptedReactiveCompact,
				MaxOutputTokensRecoveryCount: s.maxOutputTokensRecoveryCount,
				MaxOutputTokensOverride:      s.maxOutputTokensOverride,
			}
			action, recErr := e.recovery.Handle(ctx, cs, err)
			if recErr != nil {
				slog.Warn("query engine recovery failed", "err", recErr)
			}
			s.messages = cs.Messages
			s.hasAttemptedReactiveCompact = cs.HasAttemptedReactiveCompact
			s.maxOutputTokensRecoveryCount = cs.MaxOutputTokensRecoveryCount
			s.maxOutputTokensOverride = cs.MaxOutputTokensOverride

			switch action {
			case compact.ActionDrainCollapse:
				return false, s.withTransition(ContinueCollapseDrainRetry)
			case compact.ActionReactiveCompact:
				return false, s.withTransition(ContinueReactiveCompactRetry)
			case compact.ActionRetryMaxTokens:
				return false, s.withTransition(ContinueMaxOutputTokensEscalate)
			case compact.ActionStripMedia:
				return false, s.withTransition(ContinueReactiveCompactRetry)
			case compact.ActionStripSignaturesAndRetry:
				return false, s.withTransition(ContinueReactiveCompactRetry)
			case compact.ActionMultiTurnRecovery:
				return false, s.withTransition(ContinueMaxOutputTokensRecovery)
			case compact.ActionSurfaceError:
				// fallthrough to TerminalModelError
			}
		}

		send(ctx, out, EventError{Err: err, Recoverable: false})
		sendDirect(out, EventTerminal{Reason: TerminalModelError, Err: err, StructuredOutput: s.structuredOutput})
		return true, s
	}

	// [개선] 정식 도구 호출이 없으면 텍스트 본문에서 수동 추출 시도
	if len(resp.ToolCalls) == 0 {
		manualCalls := extractToolCallsFromText(resp.Content)
		if len(manualCalls) > 0 {
			slog.Info("extracted tool calls from text body", "count", len(manualCalls))
			resp.ToolCalls = manualCalls
		}
	}

	// [완전 차단 및 히스토리 정화] 
	// 도구 호출이 포함된 경우, 엔진은 텍스트 응답을 '쓰레기'로 간주하고 삭제한다.
	// 이는 에이전트가 설명만 늘어놓으며 루프에 빠지는 것을 물리적으로 방지한다.
	displayContent := resp.Content
	if len(resp.ToolCalls) > 0 {
		slog.Info("suppressing conversational text to prevent planning loop", "original_len", len(resp.Content))
		resp.Content = "" // history content is suppressed; DisplayText keeps the user-facing intro.
	}

	// 완성된 응답 방출
	if len(resp.ToolCalls) == 0 && strings.TrimSpace(resp.Content) == "" {
		// 루프 방어: 아무것도 안 내뱉으면 에러 처리
	} else {
		send(ctx, out, EventAssistantResponse{Text: resp.Content, DisplayText: displayContent, ToolCalls: resp.ToolCalls})
	}

	// 鍮??묐떟 諛⑹뼱: ?꾧뎄 ?몄텧???녾퀬 ?띿뒪?몃룄 ?녿뒗 寃쎌슦 (紐⑤뜽???쇱떆???ㅻ쪟????꾩븘??
	if len(resp.ToolCalls) == 0 && strings.TrimSpace(resp.Content) == "" {
		if s.emptyResponseRetries >= 1 {
			err := fmt.Errorf("model returned empty response repeatedly")
			slog.Error("empty response repeated; aborting turn", "turn", s.turnCount, "retries", s.emptyResponseRetries+1)
			send(ctx, out, EventError{Err: err, Recoverable: false})
			sendDirect(out, EventTerminal{Reason: TerminalModelError, Err: err, StructuredOutput: s.structuredOutput})
			return true, s
		}

		slog.Warn("empty response from model, requesting retry")
		retryMsg := llm.Message{
			Role:    llm.RoleUser,
			Content: "Error: Your previous response was empty. If you are still working, please continue. If you have finished, please provide a final summary.",
		}
		updated := make([]llm.Message, 0, len(s.messages)+2)
		updated = append(updated, s.messages...)
		updated = append(updated, llm.Message{Role: llm.RoleAssistant, Content: "(empty response)"})
		updated = append(updated, retryMsg)

		next = s
		next.messages = updated
		next.turnCount = s.turnCount + 1
		next.emptyResponseRetries = s.emptyResponseRetries + 1
		next = next.withTransition(ContinueNextTurn)
		return false, next
	}
	s.emptyResponseRetries = 0

	// JSONSchema validation: if schema is required but model returned text without tool output.
	if p.JSONSchema != nil && len(resp.ToolCalls) == 0 {
		retryMsg := llm.Message{
			Role:    llm.RoleUser,
			Content: fmt.Sprintf("Error: You must provide your final answer using the '%s' tool with the specified JSON schema. Please retry.", tools.StructuredOutputToolName),
		}
		updated := make([]llm.Message, 0, len(s.messages)+2)
		updated = append(updated, s.messages...)
		updated = append(updated, llm.Message{Role: llm.RoleAssistant, Content: resp.Content})
		updated = append(updated, retryMsg)

		next = s
		next.messages = updated
		next.turnCount = s.turnCount + 1
		next = next.withTransition(ContinueNextTurn)
		return false, next
	}

	if len(resp.ToolCalls) == 0 {
		sendDirect(out, EventTerminal{Reason: TerminalCompleted, StructuredOutput: s.structuredOutput})
		return true, s
	}

	// Tight-loop 媛먯?: ?댁쟾 turn 怨??꾩쟾???숈씪???꾧뎄 ?몄텧(batch)?몄? ?뺤씤
	if isIdenticalToolCalls(resp.ToolCalls, s.lastToolCalls) {
		slog.Warn("tight-loop detected: consecutive identical tool calls", "tool_calls", len(resp.ToolCalls))
		toolMsgs := make([]llm.Message, 0, len(resp.ToolCalls))
		for _, tc := range resp.ToolCalls {
			msg := "Error: same tool with the same arguments was requested again. Try a different approach or report the blocker to the user."
			toolMsgs = append(toolMsgs, llm.Message{
				Role:       llm.RoleTool,
				ToolCallID: tc.ID,
				Content:    msg,
			})
			send(ctx, out, EventToolResult{
				ID:        tc.ID,
				Name:      tc.Function.Name,
				ToolCall:  tc,
				Output:    msg,
				IsError:   true,
				Status:    "blocked",
				BlockKind: "repeat",
				Reason:    msg,
			})
		}
		updated := make([]llm.Message, 0, len(s.messages)+1+len(toolMsgs))
		updated = append(updated, s.messages...)
		updated = append(updated, llm.Message{Role: llm.RoleAssistant, Content: resp.Content, ToolCalls: resp.ToolCalls})
		updated = append(updated, toolMsgs...)

		next = s
		next.messages = updated
		next.turnCount = s.turnCount + 1
		next.lastToolCalls = resp.ToolCalls // 湲곕줉? 媛깆떊?섎릺 猷⑦봽???딆쓬
		next = next.withTransition(ContinueNextTurn)
		return false, next
	}

	// ?꾧뎄 諛곗튂 遺꾪븷 ??StreamingExecutor 濡??ㅽ뻾
	batches := PartitionToolCalls(resp.ToolCalls, p.Registry)
	toolResultMsgs, injectedMsgs, aborted := se.Execute(ctx, batches, out, p.RunTool, p.PendingInput)
	if aborted {
		sendDirect(out, EventTerminal{Reason: TerminalAbortedTools, StructuredOutput: s.structuredOutput})
		return true, s
	}

	// StructuredOutput 異붿텧 諛?醫낅즺 ?먮떒
	next = s
	next.lastToolCalls = resp.ToolCalls // ?ㅼ쓬 turn ???꾪빐 ?꾩옱 ?몄텧 湲곕줉 ???
	hasStructuredOutput := false
	for _, tc := range resp.ToolCalls {
		if tc.Function.Name == tools.StructuredOutputToolName {
			args := ParseArgsForCallback(tc.Function.Arguments)
			next.structuredOutput = args
			hasStructuredOutput = true
			break
		}
	}

	// 硫붿떆吏 ?대젰 ?낅뜲?댄듃: assistant + tool results
	assistantMsg := llm.Message{
		Role:      llm.RoleAssistant,
		ToolCalls: resp.ToolCalls,
	}
	updated := make([]llm.Message, 0, len(s.messages)+1+len(toolResultMsgs)+len(injectedMsgs))
	updated = append(updated, s.messages...)
	updated = append(updated, assistantMsg)
	updated = append(updated, toolResultMsgs...)
	if len(injectedMsgs) > 0 {
		updated = append(updated, injectedMsgs...)
		slog.Info("applied mid-turn injected user messages", "count", len(injectedMsgs))
	}

	next.messages = updated
	next.turnCount = s.turnCount + 1
	next = next.withTransition(ContinueNextTurn)

	if hasStructuredOutput {
		sendDirect(out, EventTerminal{Reason: TerminalCompleted, StructuredOutput: next.structuredOutput})
		return true, next
	}

	slog.Debug("query engine turn complete",
		"turn", s.turnCount,
		"tool_calls", len(resp.ToolCalls),
		"input_tokens", resp.InputTokens,
		"output_tokens", resp.OutputTokens,
	)

	return false, next
}

// callLLM ? llm.ChatStream ???몄텧?섍퀬 ?ㅽ듃由щ컢 泥?겕瑜?梨꾨꼸濡?諛⑹텧?쒕떎.
// ?쇱떆???ㅻ쪟(429, 503)??吏??諛깆삤?꾨줈 ?먮룞 ?ъ떆?꾪븳??
func (e *Engine) callLLM(
	ctx context.Context,
	p Params,
	s state,
	out chan<- QueryEvent,
) (llm.Response, error) {
	onThinking := func(tok string) {
		send(ctx, out, EventAssistantChunk{Text: tok, Thinking: true})
	}
	onToken := func(tok string) {
		send(ctx, out, EventAssistantChunk{Text: tok, Thinking: false})
	}

	msgs := make([]llm.Message, 0, 1+len(s.messages))
	msgs = append(msgs, p.SystemMsg)
	msgs = append(msgs, s.messages...)

	var opts []llm.CallOption
	if s.maxOutputTokensOverride != nil {
		opts = append(opts, llm.WithMaxTokens(*s.maxOutputTokensOverride))
	}

	retryCfg := llm.DefaultRetryConfig()
	var lastErr error
	for attempt := 0; attempt <= retryCfg.MaxRetries; attempt++ {
		if attempt > 0 {
			delay := llm.RetryDelay(attempt, retryCfg, lastErr)
			slog.Warn("llm transient error, retrying with backoff",
				"attempt", attempt, "max_retries", retryCfg.MaxRetries, "delay", delay, "err", lastErr)
			select {
			case <-ctx.Done():
				return llm.Response{}, fmt.Errorf("llm chat stream (turn %d): cancelled during retry: %w", s.turnCount, ctx.Err())
			case <-time.After(delay):
			}
		}

		resp, err := p.Client.ChatStream(ctx, msgs, p.Tools, nil, onThinking, onToken, opts...)
		if err == nil {
			return resp, nil
		}
		if !llm.IsTransient(err) {
			return llm.Response{}, fmt.Errorf("llm chat stream (turn %d): %w", s.turnCount, err)
		}
		lastErr = err
	}
	return llm.Response{}, fmt.Errorf("llm chat stream (turn %d): %w", s.turnCount, lastErr)
}

// isIdenticalToolCalls ?????꾧뎄 ?몄텧 紐⑸줉???꾩쟾???숈씪?쒖? ?뺤씤?쒕떎.
func isIdenticalToolCalls(a, b []llm.ToolCall) bool {
	if len(a) != len(b) || len(a) == 0 {
		return false
	}
	for i := range a {
		if a[i].Function.Name != b[i].Function.Name || a[i].Function.Arguments != b[i].Function.Arguments {
			return false
		}
	}
	return true
}

// extractToolCallsFromText 는 텍스트 본문에 포함된 마크다운 JSON 또는 XML 도구 호출을 추출하고 정규화한다.
func extractToolCallsFromText(content string) []llm.ToolCall {
	if content == "" {
		return nil
	}

	var results []llm.ToolCall
	// 1. 마크다운 JSON 블록 찾기: ```json ... ``` 또는 ``` ... ```
	reBlocks := regexp.MustCompile("(?s)```(?:json)?\\s*(\\{.*?\\})\\s*```")
	matches := reBlocks.FindAllStringSubmatch(content, -1)

	for _, match := range matches {
		if len(match) < 2 {
			continue
		}
		rawJSON := strings.TrimSpace(match[1])
		tc, err := parseManualToolCall(rawJSON)
		if err == nil {
			results = append(results, tc)
		}
	}

	// 2. XML 스타일 도구 호출 찾기: <tool_calls> 또는 <invoke> 또는 <tool_code>
	if len(results) == 0 {
		// <tool_name>... 형태로 시작하는 모든 태그 쌍 추출 시도
		reXML := regexp.MustCompile("(?s)<(?:tool_calls|invoke|call|tool_code|execute|action)>\\s*(.*?)\\s*</(?:tool_calls|invoke|call|tool_code|execute|action)>")
		xmlMatches := reXML.FindAllStringSubmatch(content, -1)
		for _, match := range xmlMatches {
			if len(match) < 2 {
				continue
			}
			tc, err := parseManualXMLToolCall(match[1])
			if err == nil {
				results = append(results, tc)
			}
		}
	}

	// 3. 마크다운 블록 외부의 생(Raw) JSON 형태 시도
	if len(results) == 0 {
		reRaw := regexp.MustCompile("(?s)(\\{[\\s\\n]*\"(?:action|tool|name|tool_name)\"[\\s\\n]*:.*\\})")
		rawMatch := reRaw.FindString(content)
		if rawMatch != "" {
			tc, err := parseManualToolCall(rawMatch)
			if err == nil {
				results = append(results, tc)
			}
		}
	}

	return results
}

func parseManualXMLToolCall(raw string) (llm.ToolCall, error) {
	// XML 데이터를 JSON으로 변환하거나 직접 파싱 시도
	// 가장 흔한 형태: <tool_name>name</tool_name><parameters>...</parameters>
	// 또는 단순 JSON이 태그 안에 들어있는 경우
	if strings.Contains(raw, "{") {
		return parseManualToolCall(raw)
	}

	// 태그 기반 파싱 (간이 구현)
	nameRE := regexp.MustCompile("<(?:name|tool_name|action)>(.*?)</(?:name|tool_name|action)>")
	nameMatch := nameRE.FindStringSubmatch(raw)
	if len(nameMatch) < 2 {
		// 태그가 없으면 텍스트 전체를 이름으로 간주 (단순 호출용)
		nameMatch = []string{"", strings.TrimSpace(raw)}
	}

	name := strings.TrimSpace(nameMatch[1])
	if name == "" {
		return llm.ToolCall{}, fmt.Errorf("no tool name in xml")
	}

	// 인자 추출 (태그 내부 또는 JSON)
	args := "{}"
	argsRE := regexp.MustCompile("(?s)<(?:args|arguments|params|parameters)>(.*?)</(?:args|arguments|params|parameters)>")
	argsMatch := argsRE.FindStringSubmatch(raw)
	if len(argsMatch) >= 2 {
		args = strings.TrimSpace(argsMatch[1])
	}

	return llm.ToolCall{
		ID:   fmt.Sprintf("manual_xml_%d", time.Now().UnixNano()),
		Type: "function",
		Function: llm.FunctionCall{
			Name:      name,
			Arguments: args,
		},
	}, nil
}

func parseManualToolCall(raw string) (llm.ToolCall, error) {
	// 텍스트 앞뒤에 섞인 쓰레기 제거 시도
	start := strings.Index(raw, "{")
	end := strings.LastIndex(raw, "}")
	if start == -1 || end == -1 || end <= start {
		return llm.ToolCall{}, fmt.Errorf("no json object found")
	}
	raw = raw[start : end+1]

	var m map[string]any
	if err := json.Unmarshal([]byte(raw), &m); err != nil {
		return llm.ToolCall{}, err
	}

	// [확장] {"tool_calls": [...]} 형태의 래퍼 처리
	if tcVal, ok := m["tool_calls"].([]any); ok && len(tcVal) > 0 {
		if first, ok := tcVal[0].(map[string]any); ok {
			m = first // 첫 번째 도구 호출을 대표로 처리 (루프에서 재귀적으로 확장 가능하나 일단 단일 처리)
		}
	}

	// 필드명 정규화 (Name/Type)
	var name string
	nameKeys := []string{"name", "type", "action", "tool", "tool_name", "function"}
	for _, key := range nameKeys {
		if val, ok := m[key].(string); ok && val != "" {
			name = val
			break
		}
	}

	// 필드명 정규화 (Args)
	var argsObj any
	argKeys := []string{"args", "arguments", "params", "parameters", "tasks", "data", "input", "properties"}
	for _, key := range argKeys {
		if val, ok := m[key]; ok && val != nil {
			argsObj = val
			break
		}
	}

	if name == "" {
		return llm.ToolCall{}, fmt.Errorf("invalid tool call format (missing name/type)")
	}
	
	// 인자가 없는 도구일 수도 있으므로 argsObj가 nil이면 빈 맵으로 처리
	if argsObj == nil {
		argsObj = map[string]any{}
	}

	argsB, _ := json.Marshal(argsObj)
	
	return llm.ToolCall{
		ID:   fmt.Sprintf("manual_%d", time.Now().UnixNano()),
		Type: "function",
		Function: llm.FunctionCall{
			Name:      name,
			Arguments: string(argsB),
		},
	}, nil
}

// drainPendingIntoState는 p.PendingInput에 대기 중인 입력을 drain하여 s.messages에 user 메시지로 주입한다.
// compaction 직후, callLLM 직전에 호출해 LLM이 다음 판단에 사용자 추가 입력을 반영하게 한다.
func drainPendingIntoState(ctx context.Context, src pending.PendingInputSource, s state, out chan<- QueryEvent) state {
	if src == nil || src.Len() == 0 {
		return s
	}
	drained := src.DrainAll(ctx)
	if len(drained) == 0 {
		return s
	}
	text := pending.FormatInjection(drained)
	s.messages = append(s.messages, llm.Message{Role: llm.RoleUser, Content: text})
	slog.Info("injected pending user input at turn boundary", "count", len(drained))
	send(ctx, out, EventPendingDrained{Count: len(drained)})
	return s
}
