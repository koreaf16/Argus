package agent

import (
	"strings"
	"testing"
)

func TestBuildRecoveryNudgeRAGThenWebForPackageFailure(t *testing.T) {
	a := &Agent{
		recoveryAttemptsBySignature: make(map[string]int),
	}
	records := []toolExecutionRecord{
		{
			ToolCallID:   "shell-1",
			ToolName:     "shell_exec",
			Success:      false,
			ErrorMessage: "No match for argument: oracle-database-preinstall-19c",
			Content:      "Error: No match for argument: oracle-database-preinstall-19c",
			Args: map[string]interface{}{
				"command": "dnf install -y oracle-database-preinstall-19c",
			},
			Target: "sandbox",
		},
	}

	msg, ok := a.buildRecoveryNudge(records)
	if !ok {
		t.Fatal("expected recovery nudge")
	}
	for _, want := range []string{"rag_search", "web_search", "oracle-database-preinstall-19c"} {
		if !strings.Contains(strings.ToLower(msg.Content), strings.ToLower(want)) {
			t.Fatalf("expected %q in nudge, got %q", want, msg.Content)
		}
	}
}

func TestBuildRecoveryNudgeSkipsWhenSearchAlreadyCalledInTurn(t *testing.T) {
	a := &Agent{
		recoveryAttemptsBySignature: make(map[string]int),
	}
	records := []toolExecutionRecord{
		{
			ToolCallID:   "shell-1",
			ToolName:     "shell_exec",
			Success:      false,
			ErrorMessage: "No match for argument: pkg",
		},
		{
			ToolCallID: "web-1",
			ToolName:   "web_search",
			Success:    true,
		},
	}

	if _, ok := a.buildRecoveryNudge(records); ok {
		t.Fatal("expected no nudge when web_search was already called in this turn")
	}
}

func TestBuildRecoveryNudgeLocalFixForCommandNotFound(t *testing.T) {
	a := &Agent{
		recoveryAttemptsBySignature: make(map[string]int),
	}
	records := []toolExecutionRecord{
		{
			ToolCallID:   "shell-1",
			ToolName:     "shell_exec",
			Success:      false,
			ErrorMessage: "bash: sqlplus: command not found",
			Content:      "bash: sqlplus: command not found",
			Args: map[string]interface{}{
				"command": "sqlplus / as sysdba",
			},
		},
	}

	msg, ok := a.buildRecoveryNudge(records)
	if !ok {
		t.Fatal("expected recovery nudge")
	}
	if !strings.Contains(strings.ToLower(msg.Content), "direct local remediation") {
		t.Fatalf("expected local remediation guidance, got %q", msg.Content)
	}
}

func TestBuildRecoveryNudgeStopsAfterThirdAttempt(t *testing.T) {
	a := &Agent{
		recoveryAttemptsBySignature: make(map[string]int),
	}
	records := []toolExecutionRecord{
		{
			ToolCallID:   "shell-1",
			ToolName:     "shell_exec",
			Success:      false,
			ErrorMessage: "No match for argument: pkg",
			Content:      "No match for argument: pkg",
			Args: map[string]interface{}{
				"command": "dnf install -y pkg",
			},
		},
	}

	msg1, ok1 := a.buildRecoveryNudge(records)
	msg2, ok2 := a.buildRecoveryNudge(records)
	msg3, ok3 := a.buildRecoveryNudge(records)
	if !ok1 || !ok2 || !ok3 {
		t.Fatalf("expected all three calls to return nudges, got ok1=%v ok2=%v ok3=%v", ok1, ok2, ok3)
	}
	if strings.Contains(msg1.Content, "[RECOVERY STOP]") || strings.Contains(msg2.Content, "[RECOVERY STOP]") {
		t.Fatalf("first two attempts should not be forced stop, got %q / %q", msg1.Content, msg2.Content)
	}
	if !strings.Contains(msg3.Content, "[RECOVERY STOP]") {
		t.Fatalf("third attempt should force stop, got %q", msg3.Content)
	}
}

