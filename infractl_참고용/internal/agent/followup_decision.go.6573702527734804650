package agent

import (
	"context"
	"encoding/json"
	"fmt"
	"regexp"
	"strings"

	"github.com/yourorg/infractl/internal/llm"
)

type followUpDecision struct {
	Kind       string `json:"kind"`
	Target     string `json:"target"`
	Tier       string `json:"tier,omitempty"`
	TaskType   string `json:"task_type,omitempty"`
	Complexity string `json:"complexity,omitempty"`
	Reason     string `json:"reason,omitempty"`
}

type followUpDecisionLLMResponse struct {
	Kind       string `json:"kind"`
	Target     string `json:"target"`
	Tier       string `json:"tier,omitempty"`
	TaskType   string `json:"task_type,omitempty"`
	Complexity string `json:"complexity,omitempty"`
	Reason     string `json:"reason,omitempty"`
}

var confirmationPromptPattern = regexp.MustCompile(`(?is)(\?|$).*(continue|proceed|go ahead|approve|shall i|should i|would you like|can i|진행|계속|승인|실행|할까요|하시겠습니까)`)

const followUpDecisionSystemPrompt = `You are a strict follow-up intent resolver for an infrastructure operations agent.
Return ONLY a valid JSON object. No markdown, no prose.

Output schema:
{
  "kind": "confirm" | "reject" | "revise" | "new_request" | "unclear",
  "target": "pending_action" | "pending_proposal" | "previous_confirmation" | "none",
  "tier": "fast" | "general" | "reasoning" | "",
  "task_type": "server_mgmt" | "install" | "troubleshoot" | "configure" | "analyze" | "migrate" | "plan" | "web" | "",
  "complexity": "simple" | "complex" | "",
  "reason": string
}

Decision rules:
1) Use "confirm" only when the user clearly approves execution/progression of prior context.
2) Use "reject" only when the user clearly declines/cancels.
3) Use "revise" only when user asks to modify prior proposal/plan/command.
4) Use "new_request" when user starts a different task.
5) Use "unclear" when confidence is insufficient.

Target rules:
- If prior pending command exists and user is confirming/rejecting/revising it => "pending_action".
- If prior pending task proposal exists and user is confirming/rejecting/revising it => "pending_proposal".
- If there is no pending object but the assistant just asked a confirmation question and user responds to it => "previous_confirmation".
- Otherwise "none".

Safety:
- If ambiguous between confirm and new_request, choose "unclear".
- Never guess intent from a single vague token without context support.
`

func (a *Agent) resolveFollowUpDecision(ctx context.Context, userInput string) (followUpDecision, bool) {
	decision := followUpDecision{
		Kind:   "unclear",
		Target: "none",
		Reason: "follow-up decision unresolved",
	}

	lastConfirmation := latestAssistantConfirmationPrompt(a.history)
	hasPendingAction := a.pendingAction != nil && a.pendingAction.Current() != nil
	hasPendingProposal := a.pendingProposal != nil
	hasFollowUpContext := hasPendingAction || hasPendingProposal || lastConfirmation != ""
	if !hasFollowUpContext {
		return followUpDecision{Kind: "new_request", Target: "none"}, false
	}

	client := a.llmClient
	if a.llmRegistry != nil {
		if fastClient, _, err := a.llmRegistry.Resolve(llm.TierFast); err == nil {
			client = fastClient
		}
	}
	if client == nil {
		decision.Reason = "llm unavailable for follow-up decision"
		return decision, true
	}

	messages := []llm.Message{
		{Role: llm.RoleSystem, Content: followUpDecisionSystemPrompt},
		{
			Role: llm.RoleUser,
			Content: buildFollowUpDecisionInput(
				userInput,
				a.pendingAction.Current(),
				a.pendingProposal,
				lastConfirmation,
				a.history,
			),
		},
	}

	resp, err := client.Chat(ctx, messages, nil, nil)
	if err != nil {
		decision.Reason = fmt.Sprintf("follow-up llm error: %v", err)
		return decision, true
	}

	raw := strings.TrimSpace(resp.Content)
	raw = strings.TrimPrefix(raw, "```json")
	raw = strings.TrimPrefix(raw, "```")
	raw = strings.TrimSuffix(raw, "```")
	raw = strings.TrimSpace(raw)

	var parsed followUpDecisionLLMResponse
	if err := json.Unmarshal([]byte(raw), &parsed); err != nil {
		decision.Reason = fmt.Sprintf("follow-up parse error: %v", err)
		return decision, true
	}
	return normalizeFollowUpDecision(parsed), true
}

func buildFollowUpDecisionInput(
	userInput string,
	pendingAction *PendingAction,
	pendingProposal interface {
		Summary() string
	},
	lastConfirmation string,
	history []llm.Message,
) string {
	var sb strings.Builder
	sb.WriteString("Current user input:\n")
	sb.WriteString(userInput)
	sb.WriteString("\n\n")

	if pendingAction != nil {
		sb.WriteString("Pending action:\n")
		sb.WriteString("- command: ")
		sb.WriteString(truncateForPrompt(pendingAction.ProposedCommand, 280))
		if pendingAction.Reason != "" {
			sb.WriteString("\n- reason: ")
			sb.WriteString(truncateForPrompt(pendingAction.Reason, 220))
		}
		if len(pendingAction.Plan) > 0 {
			sb.WriteString("\n- plan: ")
			sb.WriteString(truncateForPrompt(strings.Join(pendingAction.Plan, " | "), 220))
		}
		sb.WriteString("\n\n")
	}

	if pendingProposal != nil {
		sb.WriteString("Pending proposal:\n")
		sb.WriteString("- summary: ")
		sb.WriteString(truncateForPrompt(pendingProposal.Summary(), 260))
		sb.WriteString("\n\n")
	}

	if lastConfirmation != "" {
		sb.WriteString("Latest assistant confirmation prompt:\n")
		sb.WriteString(truncateForPrompt(lastConfirmation, 320))
		sb.WriteString("\n\n")
	}

	sb.WriteString("Recent history (newest last):\n")
	sb.WriteString(formatRecentHistory(history, 8))
	return sb.String()
}

func formatRecentHistory(history []llm.Message, max int) string {
	if max <= 0 || len(history) == 0 {
		return "(none)"
	}
	start := 0
	if len(history) > max {
		start = len(history) - max
	}
	var lines []string
	for _, msg := range history[start:] {
		role := strings.ToLower(string(msg.Role))
		content := strings.TrimSpace(msg.Content)
		content = strings.ReplaceAll(content, "\r\n", "\n")
		content = strings.ReplaceAll(content, "\n", " ")
		content = truncateForPrompt(content, 220)
		if content == "" && len(msg.ToolCalls) > 0 {
			content = fmt.Sprintf("[tool_calls=%d]", len(msg.ToolCalls))
		}
		if content == "" {
			content = "(empty)"
		}
		lines = append(lines, fmt.Sprintf("- %s: %s", role, content))
	}
	if len(lines) == 0 {
		return "(none)"
	}
	return strings.Join(lines, "\n")
}

func normalizeFollowUpDecision(in followUpDecisionLLMResponse) followUpDecision {
	out := followUpDecision{
		Kind:       strings.ToLower(strings.TrimSpace(in.Kind)),
		Target:     strings.ToLower(strings.TrimSpace(in.Target)),
		Tier:       normalizeTier(strings.TrimSpace(in.Tier)),
		TaskType:   strings.TrimSpace(in.TaskType),
		Complexity: normalizeComplexity(strings.TrimSpace(in.Complexity)),
		Reason:     strings.TrimSpace(in.Reason),
	}

	switch out.Kind {
	case "confirm", "reject", "revise", "new_request", "unclear":
	default:
		out.Kind = "unclear"
	}

	switch out.Target {
	case "pending_action", "pending_proposal", "previous_confirmation", "none":
	default:
		out.Target = "none"
	}

	if out.Kind == "new_request" || out.Kind == "unclear" {
		out.Target = "none"
	}
	if out.Kind != "confirm" && out.Kind != "reject" && out.Kind != "revise" {
		out.Tier = ""
		out.TaskType = ""
		out.Complexity = ""
	}
	if out.Complexity == "simple" && in.Complexity == "" {
		out.Complexity = ""
	}
	return out
}

func latestAssistantConfirmationPrompt(history []llm.Message) string {
	for i := len(history) - 1; i >= 0; i-- {
		msg := history[i]
		if msg.Role != llm.RoleAssistant {
			continue
		}
		if isConfirmationPromptText(msg.Content) {
			return msg.Content
		}
	}
	return ""
}

func isConfirmationPromptText(text string) bool {
	trimmed := strings.TrimSpace(text)
	if trimmed == "" {
		return false
	}
	return confirmationPromptPattern.MatchString(trimmed)
}

func truncateForPrompt(s string, n int) string {
	if n <= 0 || len(s) <= n {
		return s
	}
	return s[:n] + "..."
}

