type installChannelAgentStore struct {
	servers map[string]store.Server
}

func (s installChannelAgentStore) List(context.Context) ([]store.Server, error) {
	result := make([]store.Server, 0, len(s.servers))
	for _, srv := range s.servers {
		result = append(result, srv)
	}
	return result, nil
}

func (s installChannelAgentStore) Get(_ context.Context, name string) (store.Server, error) {
	for k, srv := range s.servers {
		if strings.EqualFold(k, name) || strings.EqualFold(srv.Name, name) {
			return srv, nil
		}
	}
	return store.Server{}, context.Canceled
}

