// TestIsLocalhostLiteral verifies the helper covers all blocked aliases and
// correctly allows empty string and real server names.
func TestIsLocalhostLiteral(t *testing.T) {
	blocked := []string{"localhost", "Localhost", "LOCALHOST", "local", "LOCAL", "127.0.0.1", "::1", " localhost "}
	for _, v := range blocked {
		if !isLocalhostLiteral(v) {
			t.Errorf("isLocalhostLiteral(%q) = false, want true", v)
		}
	}
	allowed := []string{"", "a100", "prod-db", "sandbox"}
	for _, v := range allowed {
		if isLocalhostLiteral(v) {
			t.Errorf("isLocalhostLiteral(%q) = true, want false", v)
		}
	}
}

// TestExecuteSingleToolBlocksLocalhostWhenActiveServerSet verifies that
// shell_exec with target="localhost" is rejected when a server is active.
func TestExecuteSingleToolBlocksLocalhostWhenActiveServerSet(t *testing.T) {
	reg := tools.NewRegistry()
	if err := reg.Register(&tools.ShellExecTool{}); err != nil {
		t.Fatalf("register shell_exec: %v", err)
	}

	mgr := executor.NewManager(noopAgentExecutor{})
	mgr.Register("a100", noopAgentExecutor{})
	a := &Agent{
		registry:     reg,
		manager:      mgr,
		handler:      noopAgentEventHandler{},
		activeServer: &store.Server{Name: "a100"},
	}

	for _, alias := range []string{"localhost", "Localhost", "127.0.0.1", "LOCAL", "::1"} {
		msg, ok := a.executeSingleTool(context.Background(), llm.ToolCall{
			ID:   "tc-block-1",
			Type: "function",
			Function: llm.FunctionCall{
				Name:      "shell_exec",
				Arguments: `{"command":"kubectl get pods","target":"` + alias + `"}`,
			},
		})
		if ok {
			t.Errorf("target=%q: expected rejection (ok=false), got ok=true", alias)
		}
		if !strings.Contains(msg.Content, "not allowed") {
			t.Errorf("target=%q: expected 'not allowed' in rejection, got %q", alias, msg.Content)
		}
	}
}

