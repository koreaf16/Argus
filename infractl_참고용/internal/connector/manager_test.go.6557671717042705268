func (c *fakeOracleConnector) ToolNames() []string { return c.names }
func (c *fakeOracleConnector) GenerateTools(info ServiceInfo, creds Credentials) []tools.Tool {
	name := "oracle_" + info.Name
	if info.SubInstance != "" {
		name += "_" + info.SubInstance
	}
	name += ".query"
	c.names = []string{name}
	return []tools.Tool{fakeTool{name: name}}
}

func TestActivateAutoRegistersOSAuthPDBConnectors(t *testing.T) {
	reg := tools.NewRegistry()
	mgr := NewManager(reg, fakeConnectorStore{})
	mgr.RegisterFactory("oracle", func() Connector { return &fakeOracleConnector{} })

	info := ServiceInfo{
		ServerName:  "oracle",
		ServiceType: "oracle",
		Name:        "AI26",
		Details: map[string]string{
			"cdb":  "yes",
			"pdbs": "AI_DB:READ WRITE,SALESPDB:MOUNTED,AI_DB:READ WRITE,PDB$SEED:READ ONLY",
		},
	}
	creds := Credentials{Username: "/", Role: "sysdba", OSAuth: true}
	if err := mgr.Activate(context.Background(), info, creds, SaveSession, nil); err != nil {
		t.Fatalf("Activate failed: %v", err)
	}

	states := mgr.States()
	if len(states) != 3 {
		t.Fatalf("expected CDB plus two distinct PDB connectors, got %d: %+v", len(states), states)
	}
	if !reg.Has("oracle_AI26_AI_DB.query") || !reg.Has("oracle_AI26_SALESPDB.query") {
		t.Fatalf("expected PDB tools to be registered")
	}
}

func TestDeactivateCDBRemovesOnlyAutoPDBConnectors(t *testing.T) {
	reg := tools.NewRegistry()
	mgr := NewManager(reg, fakeConnectorStore{})
	mgr.RegisterFactory("oracle", func() Connector { return &fakeOracleConnector{} })

	creds := Credentials{Username: "/", Role: "sysdba", OSAuth: true}
	autoInfo := ServiceInfo{
		ServerName:  "oracle",
		ServiceType: "oracle",
		Name:        "AI26",
		Details:     map[string]string{"cdb": "yes", "pdbs": "AI_DB:READ WRITE"},
	}
	if err := mgr.Activate(context.Background(), autoInfo, creds, SaveSession, nil); err != nil {
		t.Fatalf("activate CDB failed: %v", err)
	}
	manualInfo := ServiceInfo{
		ServerName:  "oracle",
		ServiceType: "oracle",
		Name:        "OTHER",
		SubInstance: "MANUALPDB",
		Details:     map[string]string{"cdb": "yes"},
	}
	if err := mgr.Activate(context.Background(), manualInfo, creds, SaveSession, nil); err != nil {
		t.Fatalf("activate manual PDB failed: %v", err)
	}

	if err := mgr.Deactivate("oracle", "oracle", "AI26"); err != nil {
		t.Fatalf("Deactivate failed: %v", err)
	}

	if reg.Has("oracle_AI26_AI_DB.query") {
		t.Fatalf("auto PDB tool should be unregistered with parent CDB")
	}
	if !reg.Has("oracle_OTHER_MANUALPDB.query") {
		t.Fatalf("manual PDB connector should remain active")
	}
}
