package tools

import (
	"context"
	"fmt"
	"regexp"
	"strings"

	sshconn "github.com/yourorg/infractl/internal/connector/ssh"
	"github.com/yourorg/infractl/internal/executor"
	"github.com/yourorg/infractl/internal/serverenv"
	"github.com/yourorg/infractl/internal/store"
)

// ServerAddTool registers a new SSH target after validating connectivity.
type ServerAddTool struct {
	Store    store.ServerStore
	Manager  *executor.Manager
	ToolName string
}

var serverAliasPattern = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$`)

func (t *ServerAddTool) Name() string {
	if strings.TrimSpace(t.ToolName) != "" {
		return t.ToolName
	}
	return "server_add"
}

func (t *ServerAddTool) Description() string {
	return "Register a new SSH server. Tests connectivity before saving. Supports key or password auth."
}

func (t *ServerAddTool) IsReadOnly() bool  { return false }
func (t *ServerAddTool) IsEnabled() bool   { return true }
func (t *ServerAddTool) IsLocalOnly() bool { return true }

func (t *ServerAddTool) Parameters() map[string]interface{} {
	return map[string]interface{}{
		"type": "object",
		"properties": map[string]interface{}{
			"name": map[string]interface{}{
				"type":        "string",
				"description": "Server name (e.g., 'db-server')",
			},
			"host": map[string]interface{}{
				"type":        "string",
				"description": "IP address or hostname",
			},
			"port": map[string]interface{}{
				"type":        "integer",
				"description": "SSH port (default: 22)",
			},
			"user": map[string]interface{}{
				"type":        "string",
				"description": "SSH username",
			},
			"auth_type": map[string]interface{}{
				"type":        "string",
				"enum":        []string{"key", "password"},
				"description": "Authentication method: 'key' for SSH private key, 'password' for password",
			},
			"credential": map[string]interface{}{
				"type":        "string",
				"description": "For auth_type=key: path to private key file. For auth_type=password: the password.",
			},
			"workspace_dir": map[string]interface{}{
				"type":        "string",
				"description": "Remote server directory for this SSH account. Default: ~/.infractl/workspace.",
			},
			"ephemeral": map[string]interface{}{
				"type":        "boolean",
				"description": "Marks this server profile as temporary/ephemeral (default: false).",
			},
			"owner_server": map[string]interface{}{
				"type":        "string",
				"description": "For ephemeral profiles, the base server profile this one belongs to.",
			},
			"owner_user": map[string]interface{}{
				"type":        "string",
				"description": "For ephemeral profiles, target service user (e.g. oracle).",
			},
			"purpose": map[string]interface{}{
				"type":        "string",
				"description": "Optional profile purpose tag (e.g. install_channel).",
			},
			"cleanup_pending": map[string]interface{}{
				"type":        "boolean",
				"description": "Marks deferred cleanup state for ephemeral profiles (default: false).",
			},
			"service_users": map[string]interface{}{
				"type":  "array",
				"items": map[string]interface{}{"type": "string"},
				"description": "Optional service account names to pre-declare (e.g. [\"oracle\",\"postgres\"]). " +
					"If omitted, auto-detected via sudo probe during server profile.",
			},
		},
		"required": []string{"name", "host", "user", "auth_type", "credential"},
	}
}

func (t *ServerAddTool) Execute(ctx context.Context, args map[string]interface{}, _ executor.Executor) (ToolOutcome, error) {
	if t.Store == nil {
		return toolFailure("Error: server store is not configured"), nil
	}

	name, err := requiredTrimmedArg(args, "name")
	if err != nil {
		return toolFailure(fmt.Sprintf("Error: %s", err)), nil
	}
	if err := validateServerAlias(name); err != nil {
		return toolFailure(fmt.Sprintf("Error: %s", err)), nil
	}
	host, err := requiredTrimmedArg(args, "host")
	if err != nil {
		return toolFailure(fmt.Sprintf("Error: %s", err)), nil
	}
	user, err := requiredTrimmedArg(args, "user")
	if err != nil {
		return toolFailure(fmt.Sprintf("Error: %s", err)), nil
	}
	authType, err := requiredTrimmedArg(args, "auth_type")
	if err != nil {
		return toolFailure(fmt.Sprintf("Error: %s", err)), nil
	}
	authType = strings.ToLower(authType)
	if authType != "key" && authType != "password" {
		return toolFailure(`Error: auth_type must be "key" or "password"`), nil
	}
	credential, err := requiredTrimmedArg(args, "credential")
	if err != nil {
		return toolFailure(fmt.Sprintf("Error: %s", err)), nil
	}
	port := argInt(args, "port", 22)
	if port <= 0 || port > 65535 {
		return toolFailure("Error: port must be between 1 and 65535"), nil
	}
	workspaceDir, _ := argString(args, "workspace_dir", false)
	workspaceDir = serverenv.RemoteDirOrDefault(strings.TrimSpace(workspaceDir))
	ephemeral := argBool(args, "ephemeral", false)
	ownerServer, _ := argString(args, "owner_server", false)
	ownerUser, _ := argString(args, "owner_user", false)
	purpose, _ := argString(args, "purpose", false)
	cleanupPending := argBool(args, "cleanup_pending", false)

	if existing, ok := t.findExisting(ctx, name); ok {
		return toolFailure(fmt.Sprintf("Error: server %q is already registered as %s@%s:%d. Use server_remove first if you want to replace it.",
			existing.Name, existing.User, existing.Host, existing.Port)), nil
	}
	if t.Manager == nil {
		return toolFailure("Error: executor manager is not configured"), nil
	}

	cfg := &sshconn.Config{
		Host:         host,
		Port:         port,
		User:         user,
		AuthType:     authType,
		WorkspaceDir: workspaceDir,
	}
	if authType == "key" {
		cfg.KeyPath = credential
	} else {
		cfg.Password = credential
	}

	client := sshconn.NewClient(cfg)
	result, runErr := client.Run(ctx, "echo ok")
	if runErr != nil {
		client.Close()
		return toolFailure(fmt.Sprintf("SSH connection test failed for %s@%s:%d: %s", user, host, port, runErr)), nil
	}
	if result.ExitCode != 0 {
		client.Close()
		return toolFailure(fmt.Sprintf("SSH test command failed (exit %d): %s", result.ExitCode, result.Stderr)), nil
	}
	workspaceCmd := fmt.Sprintf("mkdir -p %s", serverenv.POSIXShellPath(workspaceDir))
	workspaceResult, workspaceErr := client.Run(ctx, workspaceCmd)
	if workspaceErr != nil {
		client.Close()
		return toolFailure(fmt.Sprintf("Server directory setup failed for %s: %s", workspaceDir, workspaceErr)), nil
	}
	if workspaceResult.ExitCode != 0 {
		client.Close()
		return toolFailure(fmt.Sprintf("Server directory setup failed (exit %d): %s", workspaceResult.ExitCode, workspaceResult.Stderr)), nil
	}

	probeExec := sshconn.NewSSHExecutor(name, client)
	osInfo, _ := executor.DetectOS(ctx, probeExec)

	var serviceUsers []store.ServiceUser
	if suRaw, ok := args["service_users"]; ok {
		if suList, ok := suRaw.([]interface{}); ok {
			for _, item := range suList {
				if name, ok := item.(string); ok && strings.TrimSpace(name) != "" {
					serviceUsers = append(serviceUsers, store.ServiceUser{
						Name:     strings.TrimSpace(name),
						Access:   "sudo_su",
						Verified: false,
					})
				}
			}
		}
	}

	srv := store.Server{
		Name:         name,
		Host:         host,
		Port:         port,
		User:         user,
		AuthType:     store.AuthType(authType),
		Credential:   credential,
		OS:           osInfo,
		WorkspaceDir: workspaceDir,
		Ephemeral:    ephemeral,
		OwnerServer:  strings.TrimSpace(ownerServer),
		OwnerUser:    strings.TrimSpace(ownerUser),
		Purpose:      strings.TrimSpace(purpose),
		CleanupPending: cleanupPending,
		ServiceUsers: serviceUsers,
	}
	if err := t.Store.Add(ctx, srv); err != nil {
		client.Close()
		return toolFailure(fmt.Sprintf("Failed to save server: %s", err)), nil
	}

	sshExec := sshconn.NewSSHExecutor(name, client, osInfo, workspaceDir)
	t.Manager.Register(name, sshExec)

	extra := ""
	if srv.Ephemeral {
		extra = ", profile: ephemeral"
		if srv.Purpose != "" {
			extra += ", purpose: " + srv.Purpose
		}
		if srv.OwnerServer != "" || srv.OwnerUser != "" {
			extra += fmt.Sprintf(", owner: %s/%s", srv.OwnerServer, srv.OwnerUser)
		}
	}

	if strings.TrimSpace(osInfo) == "" {
		return ToolOutcome{Content: fmt.Sprintf("Server '%s' registered successfully (%s@%s:%d, auth: %s, server dir: %s%s)", name, user, host, port, authType, workspaceDir, extra), Success: true}, nil
	}
	return ToolOutcome{Content: fmt.Sprintf("Server '%s' registered successfully (%s@%s:%d, auth: %s, os: %s, server dir: %s%s)", name, user, host, port, authType, osInfo, workspaceDir, extra), Success: true}, nil
}

func (t *ServerAddTool) findExisting(ctx context.Context, name string) (store.Server, bool) {
	if t.Store == nil {
		return store.Server{}, false
	}
	servers, err := t.Store.List(ctx)
	if err != nil {
		return store.Server{}, false
	}
	for _, srv := range servers {
		if strings.EqualFold(strings.TrimSpace(srv.Name), name) {
			return srv, true
		}
	}
	return store.Server{}, false
}

func validateServerAlias(name string) error {
	name = strings.TrimSpace(name)
	if name == "" {
		return fmt.Errorf("server name is required")
	}
	if executor.IsLocalTarget(name) {
		return fmt.Errorf("server name %q is reserved for the local controller", name)
	}
	if !serverAliasPattern.MatchString(name) {
		return fmt.Errorf("server name %q is invalid; use 1-64 characters: letters, numbers, dot, underscore, or hyphen, starting with a letter or number", name)
	}
	return nil
}

func requiredTrimmedArg(args map[string]interface{}, key string) (string, error) {
	value, err := argString(args, key, true)
	if err != nil {
		return "", err
	}
	value = strings.TrimSpace(value)
	if value == "" {
		return "", fmt.Errorf("required argument missing: %s", key)
	}
	return value, nil
}

func toolFailure(content string) ToolOutcome {
	return ToolOutcome{Content: content, Success: false, ExitCode: 1, ErrorMessage: strings.TrimPrefix(content, "Error: ")}
}
