func TestFileTransferDownloadRejectsDirectoryLocalPath(t *testing.T) {
	tmp := t.TempDir()
	out, err := (&FileTransferTool{}).Execute(context.Background(), map[string]interface{}{
		"action":      "download",
		"local_path":  filepath.Clean(tmp),
		"remote_path": "report.md",
	}, fileTransferTestExec{})
	if err != nil {
		t.Fatalf("Execute() error = %v", err)
	}
	if out.Success {
		t.Fatalf("expected directory local_path to fail")
	}
	if !strings.Contains(out.Content, "destination file path") {
		t.Fatalf("unexpected output: %s", out.Content)
	}
}

func TestFileTransferUploadWithBecomeUserPreparesReadableStaging(t *testing.T) {
	tmp := t.TempDir()
	localPath := filepath.Join(tmp, "db.zip")
	if err := os.WriteFile(localPath, []byte{}, 0o644); err != nil {
		t.Fatalf("write local file: %v", err)
	}

	exec := &fileTransferUploadTestExec{}
	out, err := (&FileTransferTool{}).Execute(context.Background(), map[string]interface{}{
		"action":      "upload",
		"local_path":  localPath,
		"remote_path": "/home/oracle/final file.zip",
		"become_user": "oracle",
	}, exec)
	if err != nil {
		t.Fatalf("Execute() error = %v", err)
	}
	if !out.Success {
		t.Fatalf("expected success, got: %s", out.Content)
	}
	if len(exec.uploads) != 1 {
		t.Fatalf("expected one upload, got %d", len(exec.uploads))
	}
	if !strings.Contains(exec.uploads[0], "/tmp/.infractl/staging/db.zip") {
		t.Fatalf("unexpected staging upload path: %s", exec.uploads[0])
	}

	joined := strings.Join(exec.commands, "\n")
	if !strings.Contains(joined, "chmod 711") || !strings.Contains(joined, "/tmp/.infractl/staging") {
		t.Fatalf("expected staging dir traversal permission setup, commands:\n%s", joined)
	}
	if !strings.Contains(joined, "chmod 644 '/tmp/.infractl/staging/db.zip'") {
		t.Fatalf("expected staged file readability chmod, commands:\n%s", joined)
	}
	if !strings.Contains(joined, "cp --") ||
		!strings.Contains(joined, "/tmp/.infractl/staging/db.zip") ||
		!strings.Contains(joined, "/home/oracle/final file.zip") {
		t.Fatalf("expected quoted cp move command, commands:\n%s", joined)
	}
}

func TestFileTransferUploadBlocksOwnerMismatchBeforeSFTP(t *testing.T) {
	tmp := t.TempDir()
	localPath := filepath.Join(tmp, "db.zip")
	if err := os.WriteFile(localPath, []byte("zip"), 0o644); err != nil {
		t.Fatalf("write local file: %v", err)
	}

	exec := &fileTransferPermissionPrecheckExec{}
	out, err := (&FileTransferTool{}).Execute(context.Background(), map[string]interface{}{
		"action":      "upload",
		"local_path":  localPath,
		"remote_path": "/home/oracle/db.zip",
	}, exec)
	if err != nil {
		t.Fatalf("Execute() error = %v", err)
	}
	if out.Success {
		t.Fatalf("expected permission precheck failure, got success: %s", out.Content)
	}
	if exec.uploads != 0 {
		t.Fatalf("upload should not start after precheck failure, got %d uploads", exec.uploads)
	}
	if !strings.Contains(out.Content, "permission pre-check failed") || !strings.Contains(out.Content, "become_user=\"oracle\"") {
		t.Fatalf("unexpected output: %s", out.Content)
	}
}

func TestFileTransferUploadFinalizeFailureReportsPrivilegeProblemNotMissingLocalFile(t *testing.T) {
	tmp := t.TempDir()
	localPath := filepath.Join(tmp, "db.zip")
	if err := os.WriteFile(localPath, []byte{}, 0o644); err != nil {
		t.Fatalf("write local file: %v", err)
	}

	exec := &fileTransferFinalizePromptMissingExec{}
	out, err := (&FileTransferTool{}).Execute(context.Background(), map[string]interface{}{
		"action":        "upload",
		"local_path":    localPath,
		"remote_path":   "/home/oracle/db.zip",
		"become_user":   "oracle",
		"become_method": "sudo",
		"description":   "db zip upload",
	}, exec)
	if err != nil {
		t.Fatalf("Execute() error = %v", err)
	}
	if out.Success {
		t.Fatalf("expected finalize failure, got success: %s", out.Content)
	}
	if len(exec.uploads) != 1 || !strings.Contains(exec.uploads[0], "/tmp/.infractl/staging/db.zip") {
		t.Fatalf("expected upload to staging before finalization failure, uploads=%#v", exec.uploads)
	}
	for _, want := range []string{
		"no privilege prompt handler available",
		"Local file was verified and uploaded to staging path",
		"privilege/sudo handling problem, not a missing local file",
	} {
		if !strings.Contains(out.Content, want) {
			t.Fatalf("output missing %q:\n%s", want, out.Content)
		}
	}
	if exec.interactiveCalls != 0 {
		t.Fatalf("prompt handler failure should stop before interactive execution, got %d calls", exec.interactiveCalls)
	}
}
