func TestFileTransferTargetIsOptionalInSchema(t *testing.T) {
	params := (&FileTransferTool{}).Parameters()
	required, _ := params["required"].([]string)
	for _, field := range required {
		if field == "target" {
			t.Fatalf("target should be optional when an active server exists")
		}
	}

	props, _ := params["properties"].(map[string]interface{})
	target, _ := props["target"].(map[string]interface{})
	desc, _ := target["description"].(string)
	if !strings.Contains(desc, "Omit") || !strings.Contains(desc, "localhost") {
		t.Fatalf("target description should guide omitted active-server usage, got %q", desc)
	}
}

