type fileTransferUploadTestExec struct {
	commands []string
	uploads  []string
}

func (e *fileTransferUploadTestExec) Execute(_ context.Context, command string) (executor.ExecResult, error) {
	e.commands = append(e.commands, command)
	switch {
	case strings.Contains(command, "df -PT"):
		return executor.ExecResult{ExitCode: 0, Stdout: ""}, nil
	case strings.Contains(command, "id -Gn 'oracle'"):
		return executor.ExecResult{ExitCode: 0, Stdout: "oinstall dba\n"}, nil
	case strings.Contains(command, "stat -c"):
		return executor.ExecResult{ExitCode: 0, Stdout: "/home/oracle\toracle\toinstall\t750\n"}, nil
	case strings.Contains(command, "id 'oracle' >/dev/null 2>&1"):
		return executor.ExecResult{ExitCode: 0}, nil
	case strings.Contains(command, "sudo -n -u 'oracle' -v 2>&1"):
		return executor.ExecResult{ExitCode: 0}, nil
	case strings.Contains(command, "sudo -n -u 'oracle' -- bash -l -c"):
		return executor.ExecResult{ExitCode: 0}, nil
	default:
		return executor.ExecResult{ExitCode: 0}, nil
	}
}
func (e *fileTransferUploadTestExec) Target() string { return "sandbox" }
func (e *fileTransferUploadTestExec) Host() string   { return "sandbox" }
func (e *fileTransferUploadTestExec) Upload(_ context.Context, _ string, remotePath string, _ func(int64, int64)) error {
	e.uploads = append(e.uploads, remotePath)
	return nil
}
