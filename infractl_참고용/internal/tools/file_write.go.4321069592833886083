// Package tools
// File: file_write.go
// Description: 파일 쓰기 및 추가 도구 (권한 승격 및 문법 검증 지원)
// Responsibility: 텍스트 파일을 생성하거나 내용을 추가하며, 핵심 설정 파일 수정 전 문법 검증 수행

package tools

import (
	"context"
	"fmt"
	"path/filepath"
	"strings"
	"time"

	"github.com/yourorg/infractl/internal/diff"
	"github.com/yourorg/infractl/internal/executor"
	"github.com/yourorg/infractl/internal/privilege"
)

// FileWriteTool은 대상 시스템의 파일에 내용을 쓰거나 추가한다.
type FileWriteTool struct {
	PrivilegeCache    *privilege.Cache
	PromptHandler     privilege.PromptHandler
	ApprovalCache     *ApprovalCache
	CheckpointManager CheckpointCreator
}

func (t *FileWriteTool) Name() string { return "file_write" }

func (t *FileWriteTool) Description() string {
	return "Write or append content to a file on the target system.\n" +
		"Includes syntax validation for critical files (sudoers, sysctl, etc.).\n" +
		"Supports privilege escalation via become_method."
}

func (t *FileWriteTool) IsReadOnly() bool { return false }
func (t *FileWriteTool) IsEnabled() bool  { return true }

func (t *FileWriteTool) Parameters() map[string]interface{} {
	return map[string]interface{}{
		"type": "object",
		"properties": map[string]interface{}{
			"path": map[string]interface{}{
				"type":        "string",
				"description": "The absolute or relative path to the file",
			},
			"content": map[string]interface{}{
				"type":        "string",
				"description": "The content to write to the file",
			},
			"append": map[string]interface{}{
				"type":        "boolean",
				"description": "If true, append to existing file; if false (default), overwrite",
			},
			"target": map[string]interface{}{
				"type":        "string",
				"description": "Server alias. Omit to use the active server. Use 'localhost' ONLY for the local controller machine.",
			},
			"skip_backup": map[string]interface{}{
				"type":        "boolean",
				"description": "If true, skip automatic .bak backup before overwrite.",
			},
			"become_method": map[string]interface{}{
				"type":        "string",
				"description": "Privilege escalation method: 'sudo' or 'su'.",
				"enum":        []string{"sudo", "su"},
			},
			"become_user": map[string]interface{}{
				"type":        "string",
				"description": "Target user for privilege escalation (default: root).",
			},
		},
		"required": []string{"path", "content"},
	}
}

func (t *FileWriteTool) Execute(ctx context.Context, args map[string]interface{}, exec executor.Executor) (ToolOutcome, error) {
	path, _ := argString(args, "path", true)
	content, _ := argString(args, "content", true)
	appendMode := argBool(args, "append", false)
	skipBackup := argBool(args, "skip_backup", false)
	becomeMethod, _ := argString(args, "become_method", false)
	becomeUser, _ := argString(args, "become_user", false)

	oldContent := readExistingFile(ctx, exec, path)
	var criticalWarning string
	if warning, _ := CheckCriticalPath(path); warning != "" {
		confirmed, _ := t.confirmAction(ctx, exec, "Security Risk Detected", warning, path)
		if !confirmed {
			return ToolOutcome{Content: "[CANCELED] " + warning, Success: false, ExitCode: 1}, nil
		}
		criticalWarning = warning
	}

	// --- Syntax Validation Step ---
	valCmd := ValidateConfig(exec, path, "/tmp/.infractl_val_tmp")
	if valCmd != "" {
		// Prepare the full content to be validated
		validationContent := content
		if appendMode {
			validationContent = oldContent + content
		}

		tmpWriteCmd := buildWriteCommand(exec, "/tmp/.infractl_val_tmp", validationContent, false)
		
		// Execute temp write (needs root if target file needs root? Often /tmp is writable by user, 
		// but to be safe we can use become if requested. However, write via direct command is fine)
		if becomeMethod != "" {
			executeWithBecome(ctx, exec, tmpWriteCmd, becomeMethod, becomeUser, t.PrivilegeCache, t.PromptHandler)
		} else {
			exec.Execute(ctx, tmpWriteCmd)
		}
		
		// Run validator (usually requires root, e.g., visudo)
		valExecCmd := valCmd
		if becomeMethod != "" {
			// Try to acquire privilege for validation command too
			executeWithBecome(ctx, exec, valExecCmd, becomeMethod, becomeUser, t.PrivilegeCache, t.PromptHandler)
		} else {
			exec.Execute(ctx, valExecCmd)
		}
		
		// We actually need the result of the validation
		var valRes executor.ExecResult
		if becomeMethod != "" {
			if res, ok := executeWithAcquiredPrivilege(ctx, exec, valExecCmd, becomeUser); ok {
				valRes = res
			} else {
				valRes, _, _ = executeWithBecome(ctx, exec, valExecCmd, becomeMethod, becomeUser, t.PrivilegeCache, t.PromptHandler)
			}
		} else {
			valRes, _ = exec.Execute(ctx, valExecCmd)
		}

		if valRes.ExitCode != 0 {
			cleanCmd := "rm -f /tmp/.infractl_val_tmp"
			if becomeMethod != "" { executeWithBecome(ctx, exec, cleanCmd, becomeMethod, becomeUser, t.PrivilegeCache, t.PromptHandler) } else { exec.Execute(ctx, cleanCmd) }
			return ToolOutcome{
				Content:      fmt.Sprintf("%s\n\n[Validation Error]\n%s", GetValidateErrorHint(path), valRes.Stderr),
				Success:      false, ExitCode: 1, ErrorMessage: "Syntax validation failed",
			}, nil
		}
		cleanCmd := "rm -f /tmp/.infractl_val_tmp"
		if becomeMethod != "" { executeWithBecome(ctx, exec, cleanCmd, becomeMethod, becomeUser, t.PrivilegeCache, t.PromptHandler) } else { exec.Execute(ctx, cleanCmd) }
	}

	var backupMsg string
	if !appendMode && oldContent != "" && !skipBackup {
		backupMsg = t.performBackup(ctx, exec, path, args)
	}

	// Create checkpoint for rollback
	if t.CheckpointManager != nil {
		t.CheckpointManager.CreateMandatory(ctx, exec.Target(), t.Name(), args)
	}

	cmd := buildWriteCommand(exec, path, content, appendMode)
	
	if becomeMethod != "" {
		if result, ok := executeWithAcquiredPrivilege(ctx, exec, cmd, becomeUser); ok {
			return t.processResult(ctx, exec, result, path, content, oldContent, appendMode, criticalWarning, backupMsg)
		}
		result, ok, err := executeWithBecome(ctx, exec, cmd, becomeMethod, becomeUser, t.PrivilegeCache, t.PromptHandler)
		if ok || err != nil {
			if err != nil { return ToolOutcome{Content: fmt.Sprintf("Privilege escalation failed: %s", err), Success: false}, nil }
			return t.processResult(ctx, exec, result, path, content, oldContent, appendMode, criticalWarning, backupMsg)
		}
	}

	result, err := exec.Execute(ctx, cmd)
	if err != nil { return ToolOutcome{Content: fmt.Sprintf("Execution failed: %s", err), Success: false}, nil }

	if result.ExitCode != 0 && isPermissionFailure(result, nil) {
		if retryResult, ok := executePlainViaAcquiredRoot(ctx, exec, cmd); ok && retryResult.ExitCode == 0 {
			return t.processResult(ctx, exec, retryResult, path, content, oldContent, appendMode, criticalWarning, backupMsg)
		}
	}

	return t.processResult(ctx, exec, result, path, content, oldContent, appendMode, criticalWarning, backupMsg)
}

func (t *FileWriteTool) performBackup(ctx context.Context, exec executor.Executor, path string, args map[string]interface{}) string {
	spaceCheckCmd := buildFileSpaceCheckCmd(exec, path)
	spaceRes, spaceErr := exec.Execute(ctx, spaceCheckCmd)
	if spaceErr == nil && strings.HasPrefix(strings.TrimSpace(spaceRes.Stdout), "INSUFFICIENT:") {
		return "[Warning] Skip backup: insufficient disk space"
	}
	bakCmd := buildBackupCmd(exec, path)
	bakRes, bakErr := exec.Execute(ctx, bakCmd)
	if bakErr != nil || bakRes.ExitCode != 0 {
		return fmt.Sprintf("[Warning] backup %s.bak failed", path)
	}
	args["rollback_command"] = buildRestoreBackupCmd(exec, path)
	return fmt.Sprintf("[Backup] %s.bak", path)
}

func (t *FileWriteTool) processResult(ctx context.Context, exec executor.Executor, result executor.ExecResult, path, content, oldContent string, appendMode bool, criticalWarning, backupMsg string) (ToolOutcome, error) {
	if result.ExitCode != 0 {
		return ToolOutcome{Content: fmt.Sprintf("Error writing file (exit %d):\n%s", result.ExitCode, result.Stderr), Success: false}, nil
	}
	newContent := content
	if appendMode { newContent = oldContent + content }
	msg := fmt.Sprintf("File %s written successfully", path)
	if criticalWarning != "" { msg = criticalWarning + "\n" + msg }
	if backupMsg != "" { msg = backupMsg + "\n" + msg }
	unifiedDiff := diff.GenerateUnifiedDiff(oldContent, newContent, filepath.Base(path))
	if unifiedDiff != "" { return ToolOutcome{Content: msg + "\n\n" + unifiedDiff, Success: true}, nil }
	return ToolOutcome{Content: msg, Success: true}, nil
}

func (t *FileWriteTool) confirmAction(ctx context.Context, exec executor.Executor, title, warning, path string) (bool, error) {
	target := exec.Target()
	if t.ApprovalCache.IsApproved(target, "global_risk") { return true, nil }
	if t.PromptHandler == nil { return false, nil }
	req := QuestionRequest{
		Header:   "Security Confirmation",
		Question: fmt.Sprintf("⚠️ %s\n\n위험이 감지되었습니다:\n%s\n\n대상 파일:\n%s\n\n정말로 이 작업을 계속하시겠습니까?", title, warning, path),
		Options: []QuestionOption{
			{Label: "Run Anyway", Description: "위험을 감수하고 실행합니다."},
			{Label: "Approve for 5m", Description: "향후 5분간 이 타겟의 모든 위험 작업을 승인합니다."},
			{Label: "Cancel", Description: "작업을 중단합니다."},
		},
	}
	resp, err := RequestQuestion(ctx, req)
	if err != nil { return false, err }
	if resp.SelectedIndex == 0 { return true, nil }
	if resp.SelectedIndex == 1 {
		t.ApprovalCache.Grant(target, "global_risk", 5*time.Minute)
		return true, nil
	}
	return false, nil
}

func readExistingFile(ctx context.Context, exec executor.Executor, path string) string {
	cmd := buildReadCommand(exec, path, 0)
	result, err := exec.Execute(ctx, cmd)
	if err != nil || result.ExitCode != 0 { return "" }
	return result.Stdout
}

func buildWriteCommand(exec executor.Executor, path, content string, appendMode bool) string {
	if executor.CommandPlatform(exec) == executor.PlatformWindows {
		return buildWindowsWriteCommand(exec, path, content, appendMode)
	}
	return buildUnixWriteCommand(path, content, appendMode)
}

func buildUnixWriteCommand(path, content string, appendMode bool) string {
	redirect := ">"
	if appendMode { redirect = ">>" }
	delimiter := "INFRACTL_EOF"
	for strings.Contains(content, delimiter) { delimiter += "_X" }
	return fmt.Sprintf("cat <<'%s' %s %s\n%s\n%s", delimiter, redirect, executor.QuotePOSIX(path), content, delimiter)
}

func buildWindowsWriteCommand(exec executor.Executor, path, content string, appendMode bool) string {
	pathLit := executor.QuotePowerShell(path)
	script := fmt.Sprintf("Set-Content -LiteralPath %s -Value @'\n%s\n'@", pathLit, content)
	if appendMode { script = fmt.Sprintf("Add-Content -LiteralPath %s -Value @'\n%s\n'@", pathLit, content) }
	return executor.PowerShellCommand(exec, script)
}

func buildFileSpaceCheckCmd(exec executor.Executor, path string) string {
	if executor.CommandPlatform(exec) == executor.PlatformWindows {
		return executor.PowerShellCommand(exec, fmt.Sprintf("$target=%s; $item=Get-Item -LiteralPath $target -ErrorAction SilentlyContinue; $needed=0; if ($item -and -not $item.PSIsContainer) { $needed=[math]::Ceiling($item.Length / 1KB) }; $dir=''; if ($item) { if ($item.PSIsContainer) { $dir=$item.FullName } else { $dir=$item.Directory.FullName } } else { $dir=Split-Path -LiteralPath $target -Parent }; if ([string]::IsNullOrWhiteSpace($dir)) { $dir=(Get-Location).Path }; $probe=Get-Item -LiteralPath $dir -ErrorAction SilentlyContinue; if (-not $probe) { 'OK:0'; exit 0 }; $available=[math]::Floor($probe.PSDrive.Free / 1KB); if ($needed -gt $available) { 'INSUFFICIENT:' + $needed + ':' + $available } else { 'OK:' + $available }", executor.QuotePowerShell(path)))
	}
	return fmt.Sprintf(`available=$(df -k "$(dirname %s)" 2>/dev/null | awk 'NR==2{print $4}'); needed=$(du -k %s 2>/dev/null | cut -f1 || echo 0); [ -z "$available" ] && echo "OK:0" || { [ "$needed" -gt "$available" ] && echo "INSUFFICIENT:${needed}:${available}" || echo "OK:${available}"; }`, executor.QuotePOSIX(path), executor.QuotePOSIX(path))
}

func buildBackupCmd(exec executor.Executor, path string) string {
	if executor.CommandPlatform(exec) == executor.PlatformWindows {
		return executor.PowerShellCommand(exec, fmt.Sprintf("Copy-Item -LiteralPath %s -Destination %s -Force", executor.QuotePowerShell(path), executor.QuotePowerShell(path+".bak")))
	}
	return fmt.Sprintf("cp -p %s %s", executor.QuotePOSIX(path), executor.QuotePOSIX(path+".bak"))
}

func buildRestoreBackupCmd(exec executor.Executor, path string) string {
	if executor.CommandPlatform(exec) == executor.PlatformWindows {
		return executor.PowerShellCommand(exec, fmt.Sprintf("Copy-Item -LiteralPath %s -Destination %s -Force", executor.QuotePowerShell(path+".bak"), executor.QuotePowerShell(path)))
	}
	return fmt.Sprintf("cp -p %s %s", executor.QuotePOSIX(path+".bak"), executor.QuotePOSIX(path))
}
