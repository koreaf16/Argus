package tools

import (
	"context"
	"fmt"
	"path/filepath"
	"regexp"
	"strings"
	"time"

	"github.com/yourorg/infractl/internal/executor"
)

var (
	unzipCommandRe = regexp.MustCompile(`(?i)(?:^|[;&|]\s*)unzip\b`)
	unzipDestDirRe = regexp.MustCompile(`(?i)(?:^|[;&|]\s*)unzip\b[^;&|]*\s-d\s+\S+`)
	tarExtractCommandRe = regexp.MustCompile(`(?i)(?:^|[;&|]\s*)tar\s+(?:-[a-z]*x[a-z]*|[a-z]*x[a-z]*)\b`)
	tarDestDirRe = regexp.MustCompile(`(?i)(?:^|[;&|]\s*)tar\b[^;&|]*\s-C\s+\S+`)
	homeUserPathRe = regexp.MustCompile(`(?i)/home/([a-z_][a-z0-9_.-]*)\b`)
)

// DefensiveTactic describes command adjustments made before execution.
type DefensiveTactic struct {
	OriginalCommand string
	ModifiedCommand string
	IsBackground    bool
	LogPath         string
	Warnings        []string
}

func ApplyDefensiveTactics(cmd string, isBackground bool) *DefensiveTactic {
	tactic := &DefensiveTactic{
		OriginalCommand: cmd,
		ModifiedCommand: cmd,
		IsBackground:    isBackground,
	}
	tactic.applyAntiFlood()
	if isBackground {
		tactic.applyBackgroundWrapper()
	}
	return tactic
}

func (t *DefensiveTactic) applyAntiFlood() {
	cmd := t.ModifiedCommand
	parts := strings.Fields(cmd)
	if len(parts) == 0 {
		return
	}

	baseCmd := filepath.Base(parts[0])
	switch baseCmd {
	case "unzip":
		if !strings.Contains(cmd, " -q") {
			t.ModifiedCommand = strings.Replace(cmd, "unzip", "unzip -q", 1)
			t.Warnings = append(t.Warnings, "Added '-q' to unzip to prevent session flooding.")
		}
	case "tar":
		if strings.Contains(cmd, "-v") || strings.Contains(cmd, "v") {
			t.ModifiedCommand = strings.Replace(cmd, "v", "", 1)
			t.Warnings = append(t.Warnings, "Removed 'v' flag from tar to prevent session flooding.")
		}
	case "cp", "mv":
		if strings.Contains(cmd, " -v") {
			t.ModifiedCommand = strings.ReplaceAll(cmd, " -v", "")
			t.Warnings = append(t.Warnings, "Removed '-v' flag from copy/move command.")
		}
	}
}

func (t *DefensiveTactic) applyBackgroundWrapper() {
	logFile := fmt.Sprintf("/tmp/infractl_job_%d.log", time.Now().Unix())
	t.LogPath = logFile
	t.ModifiedCommand = fmt.Sprintf("nohup bash -c %q > %s 2>&1 & echo $!", t.ModifiedCommand, logFile)
	t.Warnings = append(t.Warnings, fmt.Sprintf("Command wrapped with nohup. Logs: %s", logFile))
}

// PerformPreflightChecks validates only concrete disk-modifying targets.
func PerformPreflightChecks(ctx context.Context, exec executor.Executor, cmd string, user string) error {
	if user != "" && user != "root" {
		checkCmd := fmt.Sprintf("id %s", user)
		res, err := exec.Execute(ctx, checkCmd)
		if err != nil || res.ExitCode != 0 {
			return fmt.Errorf("pre-flight check failed: target user %q does not exist or is inaccessible", user)
		}
	}

	if unzipCommandRe.MatchString(cmd) && !unzipDestDirRe.MatchString(cmd) {
		return fmt.Errorf("pre-flight check failed: unzip must specify an explicit destination directory with -d (e.g. -d /u01/app/oracle/stage)")
	}
	if tarExtractCommandRe.MatchString(cmd) && !tarDestDirRe.MatchString(cmd) {
		return fmt.Errorf("pre-flight check failed: tar extraction must specify an explicit destination directory with -C (e.g. -C /u01/app/oracle/stage)")
	}
	if err := validateArchiveExtractionSyntax(cmd); err != nil {
		return fmt.Errorf("pre-flight check failed: %w", err)
	}

	scan := ScanCommand(cmd)
	if scan.IsDiskModifying {
		if homeUser := inferHomeUserFromCommand(cmd); homeUser != "" {
			effectiveUser := strings.TrimSpace(user)
			if effectiveUser == "" {
				whoami, err := exec.Execute(ctx, "whoami")
				if err == nil && whoami.ExitCode == 0 {
					effectiveUser = strings.TrimSpace(whoami.Stdout)
				}
			}
			if effectiveUser == "" {
				return fmt.Errorf("pre-flight check failed: command references /home/%s but the current account could not be determined; specify become_user: %s", homeUser, homeUser)
			}
			if !strings.EqualFold(effectiveUser, homeUser) {
				return fmt.Errorf("pre-flight check failed: command references /home/%s but effective user is %q; run with become_user: %s", homeUser, effectiveUser, homeUser)
			}
		}
	}

	if !scan.IsDiskModifying || len(scan.TargetPaths) == 0 {
		return nil
	}

	for _, targetPath := range scan.TargetPaths {
		if targetPath == "" {
			continue
		}
		if warning, critical := CheckCriticalPath(targetPath); critical {
			return fmt.Errorf("pre-flight check failed: %s", warning)
		}
	}

	return nil
}

func inferHomeUserFromCommand(cmd string) string {
	matches := homeUserPathRe.FindStringSubmatch(cmd)
	if len(matches) < 2 {
		return ""
	}
	return strings.TrimSpace(matches[1])
}

func validateArchiveExtractionSyntax(cmd string) error {
	cwd := ""
	for _, seg := range splitTopLevelCommandSegments(cmd) {
		words := parseShellWords(seg.Raw)
		if len(words) == 0 {
			continue
		}
		tokens := make([]string, 0, len(words))
		for _, w := range words {
			tokens = append(tokens, shellWordValue(w.Raw))
		}
		switch strings.ToLower(filepath.Base(tokens[0])) {
		case "cd":
			if len(tokens) >= 2 {
				if !strings.HasPrefix(tokens[1], "/") {
					return fmt.Errorf("cd before archive extraction must use an absolute path, got %q", tokens[1])
				}
				cwd = strings.TrimRight(tokens[1], "/")
				if cwd == "" {
					cwd = "/"
				}
			}
		case "unzip":
			if err := validateUnzipSyntax(tokens, cwd); err != nil {
				return err
			}
		case "tar":
			if archiveLooksLikeTarExtract(tokens) {
				if err := validateTarExtractSyntax(tokens, cwd); err != nil {
					return err
				}
			}
		}
	}
	return nil
}

func validateUnzipSyntax(tokens []string, cwd string) error {
	dest := ""
	archive := ""
	for i := 1; i < len(tokens); i++ {
		tok := tokens[i]
		if tok == "-d" {
			i++
			if i >= len(tokens) {
				return fmt.Errorf("unzip -d requires an absolute destination path")
			}
			dest = tokens[i]
			continue
		}
		if strings.HasPrefix(tok, "-") {
			continue
		}
		if archive == "" {
			archive = tok
		}
	}
	if dest == "" || !strings.HasPrefix(dest, "/") {
		return fmt.Errorf("unzip destination must be an absolute path")
	}
	if archive == "" {
		return fmt.Errorf("unzip must name the source archive explicitly")
	}
	if !strings.HasPrefix(archive, "/") && cwd == "" {
		return fmt.Errorf("relative unzip archive %q requires a preceding absolute cd or an absolute archive path", archive)
	}
	return nil
}

func validateTarExtractSyntax(tokens []string, cwd string) error {
	dest := ""
	archive := ""
	for i := 1; i < len(tokens); i++ {
		tok := tokens[i]
		if tok == "-C" {
			i++
			if i >= len(tokens) {
				return fmt.Errorf("tar -C requires an absolute destination path")
			}
			dest = tokens[i]
			continue
		}
		if (tok == "-f" || tok == "--file") && i+1 < len(tokens) {
			i++
			archive = tokens[i]
			continue
		}
		if strings.HasPrefix(tok, "-f") && len(tok) > 2 {
			archive = tok[2:]
			continue
		}
		if strings.HasPrefix(tok, "-") {
			continue
		}
		if archiveLooksLikeTarFlags(tok) {
			continue
		}
		if archive == "" {
			archive = tok
		}
	}
	if dest == "" || !strings.HasPrefix(dest, "/") {
		return fmt.Errorf("tar extraction destination must be an absolute path")
	}
	if archive == "" {
		return fmt.Errorf("tar extraction must name the source archive explicitly")
	}
	if !strings.HasPrefix(archive, "/") && cwd == "" {
		return fmt.Errorf("relative tar archive %q requires a preceding absolute cd or an absolute archive path", archive)
	}
	return nil
}

func archiveLooksLikeTarExtract(tokens []string) bool {
	for _, tok := range tokens[1:] {
		if archiveLooksLikeTarFlags(tok) && strings.Contains(strings.ToLower(strings.TrimLeft(tok, "-")), "x") {
			return true
		}
	}
	return false
}

func archiveLooksLikeTarFlags(tok string) bool {
	trimmed := strings.TrimLeft(tok, "-")
	if trimmed == "" || strings.Contains(trimmed, "/") || strings.Contains(trimmed, ".") {
		return false
	}
	for _, r := range trimmed {
		if !strings.ContainsRune("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ", r) {
			return false
		}
	}
	return true
}
