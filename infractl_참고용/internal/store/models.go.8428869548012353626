package store

import (
	"encoding/json"
	"time"
)

type AuthType string

const (
	AuthTypeKey      AuthType = "key"
	AuthTypePassword AuthType = "password"
)

// ServiceUser is a service account that can be impersonated on a server via sudo or SSH.
type ServiceUser struct {
	Name     string   `json:"name"`              // e.g. "oracle", "postgres"
	Access   string   `json:"access"`            // "sudo_su" | "ssh_key" | "su"
	Purpose  []string `json:"purpose,omitempty"` // e.g. ["oracle_install","oracle_runtime"]
	Verified bool     `json:"verified"`
}

// Server is the persisted SSH-backed server definition.
// WorkspaceDir is kept for schema/API compatibility and represents only the
// remote server directory.
type Server struct {
	ID           int
	Name         string
	Host         string
	Port         int
	User         string
	AuthType     AuthType
	Credential   string
	OS           string
	EnvProfile   string
	WorkspaceDir string
	Ephemeral    bool
	OwnerServer  string
	OwnerUser    string
	Purpose      string
	CleanupPending bool
	CreatedAt    time.Time
	ServiceUsers []ServiceUser
}

// ServiceUsersJSON serializes ServiceUsers to JSON for SQLite storage.
func (s *Server) ServiceUsersJSON() string {
	if len(s.ServiceUsers) == 0 {
		return "[]"
	}
	b, _ := json.Marshal(s.ServiceUsers)
	return string(b)
}

// SetServiceUsersFromJSON deserializes ServiceUsers from a JSON string.
func (s *Server) SetServiceUsersFromJSON(raw string) {
	if raw == "" || raw == "[]" {
		s.ServiceUsers = nil
		return
	}
	_ = json.Unmarshal([]byte(raw), &s.ServiceUsers)
}
