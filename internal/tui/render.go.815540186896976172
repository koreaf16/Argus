var (
	modalStyle = lipgloss.NewStyle().
			Border(lipgloss.DoubleBorder()).
			BorderForeground(lipgloss.Color("11")).
			Padding(0, 1)

	slashOverlayStyle = lipgloss.NewStyle().
				Border(lipgloss.RoundedBorder()).
				BorderForeground(lipgloss.Color("13")).
				Padding(0, 1)
)

func renderEntry(e transcriptEntry, matched, current, summary bool) string {
	_ = matched
	_ = current
	_ = summary

	titleColor := "15"
	bodyColor := "252"
	switch e.Kind {
	case "user":
		titleColor = "10"
	case "assistant":
		titleColor = "14"
	case "tool_use":
		titleColor = "11"
	case "tool_result":
		titleColor = "6"
	case "notice":
		titleColor = "12"
	case "system":
		titleColor = "13"
	case "error":
		titleColor = "9"
	case "plan":
		titleColor = "5"
	case "approval", "password":
		titleColor = "11"
	}

	title := strings.TrimSpace(e.Title)
	if title == "" {
		title = "-"
	}
	body := strings.TrimSpace(e.Body)
	if body == "" {
		body = "-"
	}

	titleView := lipgloss.NewStyle().Bold(true).Foreground(lipgloss.Color(titleColor)).Render(title)
	bodyView := lipgloss.NewStyle().Foreground(lipgloss.Color(bodyColor)).Render(body)
	return lipgloss.JoinVertical(lipgloss.Left, titleView, bodyView)
}


func (m uiModel) renderSlashOverlay() string {
	if len(m.slashMatches) == 0 {
		return ""
	}
	lines := make([]string, 0, len(m.slashMatches)+2)
	lines = append(lines, lipgloss.NewStyle().Bold(true).Foreground(lipgloss.Color("13")).Render("Slash Commands"))
	for i, item := range m.slashMatches {
		prefix := "  "
		style := lipgloss.NewStyle().Foreground(lipgloss.Color("252"))
		if i == m.slashCursor {
			prefix = "> "
			style = style.Bold(true).Foreground(lipgloss.Color("15"))
		}
		lines = append(lines, style.Render(fmt.Sprintf("%s/%s  %s", prefix, item.Command, item.Description)))
	}
	lines = append(lines, lipgloss.NewStyle().Foreground(lipgloss.Color("245")).Render("Tab accept  Ctrl+N/Ctrl+P move"))
	return slashOverlayStyle.Render(strings.Join(lines, "\n"))
}

func (m uiModel) renderInput() string {
	return promptinput.Render(m.input.View(), m.width)
}

func (m uiModel) renderFooter() string {
	state := promptinput.FooterIdle
	if m.busy {
		state = promptinput.FooterBusy
	}
	if m.showSlashOverlay() {
		state = promptinput.FooterSlash
	}
	return promptinput.RenderFooter(promptinput.FooterConfig{
		State:      state,
		Width:      m.width,
		StatusLine: m.composeFooterStatusLine(),
	})
}

func (m uiModel) composeFooterStatusLine() string {
	left := emptyFallback(m.footer.Model, "unconfigured")
	if provider := strings.TrimSpace(m.footer.ProviderName); provider != "" {
		left += " (" + provider + ")"
	}

	rightParts := make([]string, 0, 10)
	if s := strings.TrimSpace(m.footer.PermissionSymbol); s != "" {
		rightParts = append(rightParts, s+" "+emptyFallback(m.footer.PermissionTitle, "default"))
	} else {
		rightParts = append(rightParts, emptyFallback(m.footer.PermissionTitle, "default"))
	}
	if m.footer.PlanMode {
		rightParts = append(rightParts, "PLAN")
	}
	rightParts = append(rightParts, fmt.Sprintf("todo %d", m.footer.TodoCount))
	rightParts = append(rightParts, fmt.Sprintf("mcp %d", m.footer.MCPCount))
	rightParts = append(rightParts, fmt.Sprintf("skills %d", m.footer.SkillCount))
	rightParts = append(rightParts, "ws "+emptyFallback(m.footer.Workspace, "local"))
	if cwd := strings.TrimSpace(m.footer.CWD); cwd != "" {
		rightParts = append(rightParts, "cwd "+cwd)
	}
	if sid := shortSessionID(m.footer.SessionID); sid != "" {
		rightParts = append(rightParts, "session "+sid)
	}
	rightParts = append(rightParts, "v"+constants.Version)

	sep := " | "
	right := strings.Join(rightParts, sep)
	if m.width <= 0 {
		return left + "  " + right
	}

	// Keep key badges by progressively removing lower-priority detail fields.
	for lipgloss.Width(left)+2+lipgloss.Width(right) > m.width && len(rightParts) > 0 {
		removeIdx := -1
		for i, part := range rightParts {
			switch {
			case strings.HasPrefix(part, "session "):
				removeIdx = i
			case strings.HasPrefix(part, "skills "):
				if removeIdx == -1 {
					removeIdx = i
				}
			case strings.HasPrefix(part, "mcp "):
				if removeIdx == -1 {
					removeIdx = i
				}
			case strings.HasPrefix(part, "ws "):
				if removeIdx == -1 {
					removeIdx = i
				}
			case strings.HasPrefix(part, "cwd "):
				if removeIdx == -1 {
					removeIdx = i
				}
			case strings.HasPrefix(part, "todo "):
				if removeIdx == -1 {
					removeIdx = i
				}
			}
		}
		if removeIdx == -1 {
			break
		}
		rightParts = append(rightParts[:removeIdx], rightParts[removeIdx+1:]...)
		right = strings.Join(rightParts, sep)
	}

	gap := m.width - lipgloss.Width(left) - lipgloss.Width(right)
	if gap < 2 {
		gap = 2
	}
	return left + strings.Repeat(" ", gap) + right
}

func shortSessionID(id string) string {
	id = strings.TrimSpace(id)
	if id == "" {
		return ""
	}
	if len(id) <= 10 {
		return id
	}
	return id[len(id)-10:]
}

func (m uiModel) renderModal() string {
	switch m.modal.Kind {
	case modalApproval:
		inner := []string{
			lipgloss.NewStyle().Bold(true).Render(m.modal.Title),
			m.modal.Prompt,
			"",
			"tool: " + m.modal.ToolName,
		}
		if hint := approvalHint(m.modal.ToolName); hint != "" {
			inner = append(inner, "hint: "+hint)
		}
		if strings.TrimSpace(m.modal.InputJSON) != "" {
			inner = append(inner, m.modal.InputJSON)
		}
		inner = append(inner, "", "[Y] Allow   [N] Deny   [Enter] default(deny)   [Esc] Deny")
		return modalStyle.Render(strings.Join(inner, "\n"))
	case modalConfirm:
		inner := []string{
			lipgloss.NewStyle().Bold(true).Render(m.modal.Title),
			m.modal.Prompt,
			"",
			"[Y] Yes   [N] No   [Enter] default   [Esc] No",
		}
		return modalStyle.Render(strings.Join(inner, "\n"))
	case modalPassword:
		mask := strings.Repeat("*", len(m.modal.Password))
		inner := []string{
			lipgloss.NewStyle().Bold(true).Render(m.modal.Title),
			strings.TrimSpace(m.modal.Prompt),
			"",
			mask,
			"",
			"[Enter] submit   [Esc] cancel",
		}
		return modalStyle.Render(strings.Join(inner, "\n"))
	default:
		return ""
	}
}

func emptyFallback(v, fallback string) string {
	if strings.TrimSpace(v) == "" {
		return fallback
	}
	return strings.TrimSpace(v)
}

func approvalHint(toolName string) string {
	n := strings.ToLower(toolName)
	switch {
	case strings.Contains(n, "search"):
		return "Review result source URLs before continuing."
	case strings.Contains(n, "fetch"), strings.Contains(n, "crawl"):
		return "This may pull full page content; check sensitive data risk."
	case strings.Contains(n, "bash"), strings.Contains(n, "shell"), strings.Contains(n, "powershell"):
		return "Command execution can modify files or system state."
	case strings.Contains(n, "write"), strings.Contains(n, "edit"), strings.Contains(n, "patch"):
		return "File edits requested; verify target path and diff."
	default:
		return ""
	}
}

func renderLogoBlock(cfg Config) string {
	var modelDisplay, effortLevel, providerName string
	effortLevel = "high"
	if cfg.State != nil {
		_, disp, _ := cfg.State.ActiveModel()
		modelDisplay = disp
		effortLevel = cfg.State.GetEffortLevel()
		providerName = cfg.State.ActiveModelProvider()
	}
	return logo.Render(logo.Data{
		Version:      constants.Version,
		ModelDisplay: modelDisplay,
		EffortLevel:  effortLevel,
		ProviderName: providerName,
		Cwd:          cfg.WorkDir,
	}, cfg.AIDebug)
}

func renderTranscriptEntry(e transcriptEntry) string {
	return renderEntry(e, false, false, false)
}
