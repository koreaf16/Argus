type Config struct {
	Engine       *query.Engine
	Registry     *llm.Registry
	State        *state.AppState
	ModelPath    string
	SettingsPath string
	WorkDir      string
	Memory       *memdir.Store
	MCP          *mcp.Manager
	LSP          *lsp.Manager
	Workspace    *workspace.Manager
	Skills       *skills.Registry
	MCPReload    func() error
	AIDebug      bool
}

type app struct {
	cfg      Config
	rl       *readline.Instance
	renderer *presentation.TextRenderer

	readMu sync.Mutex

	lastFooter presentation.FooterState
}

func Run(ctx context.Context, cfg Config) error {
	if cfg.Engine == nil {
		return errors.New("tui requires query engine")
	}
	if cfg.Registry == nil {
		return errors.New("tui requires model registry")
	}
	if cfg.State == nil {
		cfg.State = state.NewAppState()
	}
	if cfg.ModelPath == "" {
		cfg.ModelPath = constants.ModelsPath()
	}
	if cfg.SettingsPath == "" {
		cfg.SettingsPath = constants.SettingsPath()
	}
	if cfg.WorkDir == "" {
		if wd, err := os.Getwd(); err == nil {
			cfg.WorkDir = wd
		}
	}
	if err := os.MkdirAll(constants.ConfigDir(), 0o755); err != nil {
		return err
	}

	rl, err := readline.NewEx(&readline.Config{
		Prompt:          "[prompt] ",
		HistoryFile:     constants.HistoryPath(),
		InterruptPrompt: "^C",
		EOFPrompt:       "exit",
	})
	if err != nil {
		return err
	}
	defer rl.Close()

	a := &app{
		cfg:        cfg,
		rl:         rl,
		renderer:   presentation.NewTextRenderer(rl.Stdout(), cfg.AIDebug),
		lastFooter: presentation.FooterState{},
	}
	a.cfg.Engine.SetDeps(query.Deps{
		WorkingDir: cfg.WorkDir,
		Workspace:  cfg.Workspace,
		ApproveTool: query.ApprovalGate{
			Prompt: a.promptToolApproval,
		},
	})

	a.replayTranscript()
	a.emitFooter(true)

	for {
		select {
		case <-ctx.Done():
			return ctx.Err()
		default:
		}

		line, err := a.readLine("[prompt] ")
		if err == readline.ErrInterrupt {
			continue
		}
		if errors.Is(err, io.EOF) {
			fmt.Fprintln(a.rl.Stdout())
			return nil
		}
		if err != nil {
			return err
		}

		input := strings.TrimSpace(line)
		if input == "" {
			a.emitFooter(false)
			continue
		}

		if strings.HasPrefix(input, "/") {
			quit, loadedSession, cmdErr := a.handleSlashCommand(ctx, input)
			if cmdErr != nil {
				a.renderer.Emit(presentation.Event{
					Kind: presentation.EventError,
					Text: cmdErr.Error(),
				})
			}
			if loadedSession {
				a.renderer.Emit(presentation.Event{Kind: presentation.EventViewCleared})
				a.replayTranscript()
			}
			a.emitFooter(false)
			if quit {
				return nil
			}
			continue
		}

		a.renderer.Emit(presentation.Event{
			Kind: presentation.EventUser,
			Text: input,
		})
		stream, err := a.cfg.Engine.SubmitMessage(ctx, input)
		if err != nil {
			a.renderer.Emit(presentation.Event{
				Kind: presentation.EventError,
				Text: err.Error(),
			})
			a.emitFooter(false)
			continue
		}

		var (
			plannedSteps []query.PlannedStep
			streamFailed bool
		)
		for evt := range stream {
			if pe, ok := presentation.FromUIEvent(evt); ok {
				a.renderer.Emit(pe)
			}
			switch evt.Kind {
			case query.UIEventPasswordPrompt:
				pwPrompt := strings.TrimSpace(evt.Prompt)
				if pwPrompt == "" {
					pwPrompt = "Password:"
				}
				if !strings.HasSuffix(pwPrompt, " ") {
					pwPrompt += " "
				}
				pw, pwErr := a.readPassword(pwPrompt)
				if evt.PasswordResponse != nil {
					if pwErr != nil {
						evt.PasswordResponse <- ""
					} else {
						evt.PasswordResponse <- string(pw)
					}
				}
			case query.UIEventPlanExecutionReady:
				plannedSteps = append([]query.PlannedStep(nil), evt.PlanSteps...)
			case query.UIEventError:
				streamFailed = true
			}
		}
		a.renderer.Close()
		if len(plannedSteps) > 0 && !streamFailed {
			a.runPlannedSteps(ctx, plannedSteps)
		}
		a.emitFooter(false)
	}
}

func (a *app) replayTranscript() {
	for _, evt := range presentation.ReplayEvents(a.cfg.Engine.Messages()) {
		a.renderer.Emit(evt)
	}
	a.renderer.Close()
}

func (a *app) emitFooter(force bool) {
	footer := presentation.BuildFooterState(a.cfg.State, a.cfg.WorkDir)
	if !force && presentation.FooterEqual(footer, a.lastFooter) {
		return
	}
	a.lastFooter = footer
	a.renderer.Emit(presentation.Event{
		Kind:   presentation.EventState,
		Footer: footer,
	})
}

func (a *app) promptToolApproval(ctx context.Context, toolName string, input json.RawMessage) (bool, error) {
	_ = ctx
	a.renderer.Emit(presentation.Event{
		Kind:     presentation.EventApprovalRequest,
		ToolName: toolName,
		Input:    presentation.FormatInputJSON(input),
	})
	allowed, err := a.promptYesNo(fmt.Sprintf("allow %s? [y/N]", toolName), false)
	decision := "deny"
	if allowed {
		decision = "allow"
	}
	a.renderer.Emit(presentation.Event{
		Kind:     presentation.EventApprovalDecision,
		Decision: decision,
	})
	return allowed, err
}

func (a *app) handleSlashCommand(ctx context.Context, line string) (quit bool, loadedSession bool, err error) {
	if strings.EqualFold(strings.TrimSpace(line), "/clear") {
		a.renderer.Emit(presentation.Event{Kind: presentation.EventViewCleared})
		return false, false, nil
	}

	sink := &lineCaptureWriter{
		onLine: func(s string) {
			s = strings.TrimSpace(s)
			if s == "" {
				return
			}
			a.renderer.Emit(presentation.Event{
				Kind: presentation.EventSystem,
				Text: s,
			})
		},
	}
	cmdCtx := commands.CommandContext{
		Context:      ctx,
		Stdout:       sink,
		State:        a.cfg.State,
		Registry:     a.cfg.Registry,
		Engine:       a.cfg.Engine,
		ModelPath:    a.cfg.ModelPath,
		SettingsPath: a.cfg.SettingsPath,
		WorkDir:      a.cfg.WorkDir,
		Memory:       a.cfg.Memory,
		MCP:          a.cfg.MCP,
		LSP:          a.cfg.LSP,
		Workspace:    a.cfg.Workspace,
		Skills:       a.cfg.Skills,
		MCPReload:    a.cfg.MCPReload,
		ModelHandler: a.handleModelCommand,
	}
	quit, err = commands.Dispatch(line, cmdCtx)
	sink.Flush()
	if err != nil {
		return quit, false, err
	}
	loadedSession = isSessionLoadCommand(line)
	return quit, loadedSession, nil
}

func (a *app) handleModelCommand(args []string) error {
	if len(args) == 0 {
		a.renderer.Emit(presentation.Event{
			Kind: presentation.EventSystem,
			Text: a.cfg.Registry.FormatTable(),
		})
		return nil
	}
	switch strings.ToLower(args[0]) {
	case "show":
		if len(args) < 2 {
			return fmt.Errorf("usage: /model show <alias>")
		}
		info, err := a.cfg.Registry.Show(args[1])
		if err != nil {
			return err
		}
		a.renderer.Emit(presentation.Event{
			Kind: presentation.EventSystem,
			Text: info,
		})
		return nil
	case "rm":
		if len(args) < 2 {
			return fmt.Errorf("usage: /model rm <alias>")
		}
		if err := a.cfg.Registry.Remove(args[1]); err != nil {
			return err
		}
		if err := a.cfg.Registry.Save(a.cfg.ModelPath); err != nil {
			return err
		}
		return a.refreshEngineLLM()
	case "add":
		entry, err := a.interactiveAddModel()
		if err != nil {
			return err
		}
		if err := a.cfg.Registry.Add(entry); err != nil {
			return err
		}
		if err := a.cfg.Registry.Save(a.cfg.ModelPath); err != nil {
			return err
		}
		a.renderer.Emit(presentation.Event{
			Kind: presentation.EventSystem,
			Text: fmt.Sprintf("added model alias: %s", entry.Alias),
		})
		return nil
	default:
		target := args[0]
		if _, err := strconv.Atoi(target); err != nil {
			// ResolveSwitchToken handles alias lookup.
		}
		entry, err := a.cfg.Registry.ResolveSwitchToken(target)
		if err != nil {
			return err
		}
		if err := a.cfg.Registry.SetActive(entry.Alias); err != nil {
			return err
		}
		if err := a.cfg.Registry.Save(a.cfg.ModelPath); err != nil {
			return err
		}
		if err := a.refreshEngineLLM(); err != nil {
			return err
		}
		a.renderer.Emit(presentation.Event{
			Kind: presentation.EventSystem,
			Text: fmt.Sprintf("active model: %s (%s)", entry.Alias, entry.Display),
		})
		return nil
	}
}

func (a *app) interactiveAddModel() (llm.ModelEntry, error) {
	providerRaw, err := a.promptLine("provider (anthropic|gemini|openai-compat)", "openai-compat")
	if err != nil {
		return llm.ModelEntry{}, err
	}
	provider := llm.Provider(strings.TrimSpace(providerRaw))
	if provider != llm.ProviderAnthropic && provider != llm.ProviderGemini && provider != llm.ProviderOpenAICompat {
		return llm.ModelEntry{}, fmt.Errorf("invalid provider: %s", providerRaw)
	}
	alias, err := a.promptLine("alias", "")
	if err != nil {
		return llm.ModelEntry{}, err
	}
	modelID, err := a.promptLine("model id", "")
	if err != nil {
		return llm.ModelEntry{}, err
	}
	baseURL := ""
	if provider == llm.ProviderOpenAICompat {
		baseURL, err = a.promptLine("base url", "https://api.openai.com/v1")
		if err != nil {
			return llm.ModelEntry{}, err
		}
	}
	apiEnvDefault := "OPENAI_API_KEY"
	if provider == llm.ProviderAnthropic {
		apiEnvDefault = "ANTHROPIC_API_KEY"
	}
	if provider == llm.ProviderGemini {
		apiEnvDefault = "GEMINI_API_KEY"
	}
	if provider == llm.ProviderOpenAICompat {
		apiEnvDefault = ""
	}
	apiKeyEnv, err := a.promptLine("api key env", apiEnvDefault)
	if err != nil {
		return llm.ModelEntry{}, err
	}
	display, err := a.promptLine("display name", modelID)
	if err != nil {
		return llm.ModelEntry{}, err
	}
	ctxWinRaw, err := a.promptLine("context window", "0")
	if err != nil {
		return llm.ModelEntry{}, err
	}
	ctxWin := 0
	if n, convErr := strconv.Atoi(strings.TrimSpace(ctxWinRaw)); convErr == nil {
		ctxWin = n
	}

	return llm.ModelEntry{
		Alias:      alias,
		ModelID:    modelID,
		Provider:   provider,
		BaseURL:    baseURL,
		APIKeyEnv:  apiKeyEnv,
		Display:    display,
		ContextWin: ctxWin,
		Caps:       llm.DefaultCapsForProvider(provider),
	}, nil
}

func (a *app) promptLine(label, def string) (string, error) {
	prompt := label
	if strings.TrimSpace(def) != "" {
		prompt += " [" + def + "]"
	}
	prompt += ": "
	line, err := a.readLine(prompt)
	if err != nil {
		return "", err
	}
	line = strings.TrimSpace(line)
	if line == "" {
		return def, nil
	}
	return line, nil
}

func (a *app) promptYesNo(label string, def bool) (bool, error) {
	defaultToken := "n"
	if def {
		defaultToken = "y"
	}
	answer, err := a.promptLine(label, defaultToken)
	if err != nil {
		return false, err
	}
	answer = strings.ToLower(strings.TrimSpace(answer))
	return answer == "y" || answer == "yes", nil
}

func (a *app) refreshEngineLLM() error {
	client, err := a.cfg.Registry.Build()
	if err != nil {
		a.cfg.Engine.SetLLM(llm.NewErrorLLM("registry", llm.Caps{}, err))
		return err
	}
	a.cfg.Engine.SetLLM(client)
	if active, ok := a.cfg.Registry.ActiveEntry(); ok && a.cfg.State != nil {
		a.cfg.State.SetActiveModel(active.Alias, active.Display, active.ContextWin)
	}
	return nil
}

func (a *app) runPlannedSteps(ctx context.Context, steps []query.PlannedStep) {
	if len(steps) == 0 || a.cfg.Engine == nil {
		return
	}
	sessionID := todostore.SessionID("")
	if a.cfg.State != nil {
		sessionID = todostore.SessionID(a.cfg.State.SessionID())
	}

	existing, _ := todostore.Load(sessionID)
	if a.cfg.State != nil {
		stateTodos := a.cfg.State.Todos(sessionID)
		if len(stateTodos) > 0 {
			existing = stateTodos
		}
	}
	todos := todostore.SyncForSteps(existing, toTodoSteps(steps))
	_ = persistSessionTodos(a.cfg, sessionID, todos)

	for i, step := range steps {
		idx := i + 1
		a.renderer.Emit(presentation.Event{
			Kind:      presentation.EventPlanStep,
			StepIndex: idx,
			StepTotal: len(steps),
			ToolName:  step.Tool,
			Text:      step.Prompt,
		})

		ok, err := a.promptYesNo(fmt.Sprintf("run step %d/%d? [y/N]", idx, len(steps)), false)
		decision := "deny"
		if ok {
			decision = "allow"
		}
		a.renderer.Emit(presentation.Event{
			Kind:      presentation.EventPlanDecision,
			StepIndex: idx,
			StepTotal: len(steps),
			Decision:  decision,
		})
		if err != nil {
			a.renderer.Emit(presentation.Event{
				Kind: presentation.EventError,
				Text: fmt.Sprintf("step approval failed: %v", err),
			})
			return
		}
		if !ok {
			a.renderer.Emit(presentation.Event{
				Kind: presentation.EventNotice,
				Text: fmt.Sprintf("plan execution stopped at step %d/%d", idx, len(steps)),
			})
			_ = persistSessionTodos(a.cfg, sessionID, todos)
			return
		}

		todos[i].Status = types.TodoStatusInProgress
		_ = persistSessionTodos(a.cfg, sessionID, todos)

		result, err := a.cfg.Engine.ExecutePlannedStep(ctx, step)
		if err != nil {
			todos[i].Status = types.TodoStatusPending
			_ = persistSessionTodos(a.cfg, sessionID, todos)
			a.renderer.Emit(presentation.Event{
				Kind:      presentation.EventPlanResult,
				StepIndex: idx,
				StepTotal: len(steps),
				Text:      "failed: " + err.Error(),
			})
			return
		}

		todos[i].Status = types.TodoStatusCompleted
		_ = persistSessionTodos(a.cfg, sessionID, todos)
		a.renderer.Emit(presentation.Event{
			Kind:      presentation.EventPlanResult,
			StepIndex: idx,
			StepTotal: len(steps),
			Text:      "completed: " + truncatePlanStepOutput(result),
		})
	}
	a.renderer.Emit(presentation.Event{
		Kind: presentation.EventNotice,
		Text: fmt.Sprintf("plan execution completed (%d/%d)", len(steps), len(steps)),
	})
}

func (a *app) readLine(prompt string) (string, error) {
	a.readMu.Lock()
	defer a.readMu.Unlock()
	a.rl.SetPrompt(prompt)
	return a.rl.Readline()
}

func (a *app) readPassword(prompt string) ([]byte, error) {
	a.readMu.Lock()
	defer a.readMu.Unlock()
	return a.rl.ReadPassword(prompt)
}

func toTodoSteps(steps []query.PlannedStep) []todostore.Step {
	out := make([]todostore.Step, 0, len(steps))
	for _, step := range steps {
		out = append(out, todostore.Step{
			Tool:   step.Tool,
			Prompt: step.Prompt,
		})
	}
	return out
}

func persistSessionTodos(cfg Config, sessionID string, todos []types.TodoItem) error {
	if err := todostore.Save(sessionID, todos); err != nil {
		return err
	}
	if cfg.State != nil {
		cfg.State.SetTodos(sessionID, todostore.NormalizeForStorage(todos))
	}
	return nil
}

func truncatePlanStepOutput(s string) string {
	s = strings.TrimSpace(s)
	if len(s) > 500 {
		return s[:500] + " ... (truncated)"
	}
	if s == "" {
		return "(no output)"
	}
	return s
}

func isSessionLoadCommand(line string) bool {
	fields := strings.Fields(strings.TrimPrefix(strings.TrimSpace(line), "/"))
	return len(fields) >= 3 && strings.EqualFold(fields[0], "session") && strings.EqualFold(fields[1], "load")
}

type lineCaptureWriter struct {
	mu     sync.Mutex
	buf    strings.Builder
	onLine func(string)
}

func (w *lineCaptureWriter) Write(p []byte) (int, error) {
	w.mu.Lock()
	defer w.mu.Unlock()
	for _, b := range p {
		if b == '\n' {
			w.flushLineLocked()
			continue
		}
		w.buf.WriteByte(b)
	}
	return len(p), nil
}

func (w *lineCaptureWriter) Flush() {
	w.mu.Lock()
	defer w.mu.Unlock()
	w.flushLineLocked()
}

func (w *lineCaptureWriter) flushLineLocked() {
	if w.onLine == nil {
		w.buf.Reset()
		return
	}
	line := strings.TrimRight(w.buf.String(), "\r")
	w.buf.Reset()
	if line == "" {
		return
	}
	w.onLine(line)
}

