package tui

import (
	"errors"
	"fmt"
	"strings"

	"github.com/charmbracelet/bubbles/textarea"
	"github.com/charmbracelet/bubbles/viewport"
	tea "github.com/charmbracelet/bubbletea"
	"github.com/charmbracelet/lipgloss"
	"github.com/koreaf16/argus/internal/presentation"
	"github.com/koreaf16/argus/internal/query"
	"github.com/koreaf16/argus/internal/types"
	"github.com/koreaf16/argus/internal/utils/permissions"
)

type submitStartedMsg struct{}
type submitFinishedMsg struct{}
type quitRequestedMsg struct{}

type queryEventMsg struct {
	Event query.UIEvent
}

type presentationEventMsg struct {
	Event presentation.Event
}

type footerStateMsg struct {
	Footer presentation.FooterState
}

type decisionResult struct {
	Allow bool
	Err   error
}

type passwordResult struct {
	Value string
	Err   error
}

type approvalRequestMsg struct {
	ToolName string
	Input    string
	Response chan decisionResult
}

type confirmRequestMsg struct {
	Prompt    string
	DefaultNo bool
	Response  chan decisionResult
}

type passwordRequestMsg struct {
	Prompt   string
	Response chan passwordResult
}

type modalKind int

const (
	modalNone modalKind = iota
	modalApproval
	modalConfirm
	modalPassword
)

type modalState struct {
	Kind      modalKind
	Title     string
	Prompt    string
	ToolName  string
	InputJSON string
	Password  string
	DefaultNo bool
	DecisionC chan decisionResult
	PasswordC chan passwordResult
}

type transcriptEntry struct {
	Kind  string
	Title string
	Body  string
}

type uiModel struct {
	app *app
	cfg Config

	width  int
	height int

	viewport viewport.Model
	input    textarea.Model
	footer   presentation.FooterState

	entries            []transcriptEntry
	assistantOpen      bool
	assistantStreamIdx int

	busy bool

	modalQueue []modalState
	modal      modalState
}

func newUIModel(a *app, cfg Config) uiModel {
	in := textarea.New()
	in.Placeholder = "메시지를 입력하세요"
	in.Prompt = "┃ "
	in.ShowLineNumbers = false
	in.CharLimit = 0
	in.SetHeight(4)
	in.Focus()

	vp := viewport.New(0, 0)
	vp.SetContent("")

	m := uiModel{
		app:               a,
		cfg:               cfg,
		viewport:          vp,
		input:             in,
		entries:           make([]transcriptEntry, 0, 128),
		assistantStreamIdx: -1,
		footer:            presentation.BuildFooterState(cfg.State, cfg.WorkDir),
	}
	for _, evt := range presentation.ReplayEvents(cfg.Engine.Messages()) {
		m.applyPresentationEvent(evt)
	}
	m.refreshViewport(true)
	return m
}

func (m uiModel) Init() tea.Cmd {
	return textarea.Blink
}

func (m uiModel) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	switch v := msg.(type) {
	case tea.WindowSizeMsg:
		m.width = v.Width
		m.height = v.Height
		m.resize()
		return m, nil
	case quitRequestedMsg:
		return m, tea.Quit
	case submitStartedMsg:
		m.busy = true
		return m, nil
	case submitFinishedMsg:
		m.busy = false
		m.refreshViewport(true)
		return m, nil
	case queryEventMsg:
		if evt, ok := presentation.FromUIEvent(v.Event); ok {
			m.applyPresentationEvent(evt)
			m.refreshViewport(false)
		}
		return m, nil
	case presentationEventMsg:
		m.applyPresentationEvent(v.Event)
		m.refreshViewport(false)
		return m, nil
	case footerStateMsg:
		m.footer = v.Footer
		return m, nil
	case approvalRequestMsg:
		m.enqueueModal(modalState{
			Kind:      modalApproval,
			Title:     "Tool Permission",
			Prompt:    "이 도구 실행을 허용할까요?",
			ToolName:  v.ToolName,
			InputJSON: v.Input,
			DecisionC: v.Response,
		})
		return m, nil
	case confirmRequestMsg:
		m.enqueueModal(modalState{
			Kind:      modalConfirm,
			Title:     "Confirm",
			Prompt:    v.Prompt,
			DefaultNo: v.DefaultNo,
			DecisionC: v.Response,
		})
		return m, nil
	case passwordRequestMsg:
		m.enqueueModal(modalState{
			Kind:      modalPassword,
			Title:     "Password Required",
			Prompt:    v.Prompt,
			PasswordC: v.Response,
		})
		return m, nil
	case tea.KeyMsg:
		if m.modal.Kind != modalNone {
			m.handleModalKey(v)
			return m, nil
		}
		switch v.String() {
		case "ctrl+c":
			return m, tea.Quit
		case "enter":
			text := strings.TrimSpace(m.input.Value())
			if text == "" {
				return m, nil
			}
			if m.busy {
				m.applyPresentationEvent(presentation.Event{
					Kind: presentation.EventNotice,
					Text: "이전 요청이 아직 진행 중입니다.",
				})
				m.refreshViewport(true)
				return m, nil
			}
			m.input.SetValue("")
			m.input.SetCursor(0)
			m.app.submit(text)
			return m, nil
		case "ctrl+j":
			m.input.InsertRune('\n')
			m.resize()
			return m, nil
		case "pgup":
			m.viewport.HalfViewUp()
			return m, nil
		case "pgdown":
			m.viewport.HalfViewDown()
			return m, nil
		case "home":
			m.viewport.GotoTop()
			return m, nil
		case "end":
			m.viewport.GotoBottom()
			return m, nil
		case "shift+tab":
			m.cyclePermissionMode()
			return m, nil
		}

		var cmd tea.Cmd
		m.input, cmd = m.input.Update(v)
		m.resize()
		return m, cmd
	}
	return m, nil
}

func (m *uiModel) cyclePermissionMode() {
	if m.cfg.State == nil {
		return
	}
	permCtx := permissions.NewDefaultPermissionContext()
	permCtx.Mode = m.cfg.State.GetPermissionMode()
	next, _ := permissions.CyclePermissionMode(permCtx)
	m.cfg.State.SetPermissionMode(next)
	if next == types.PermissionModePlan {
		m.cfg.State.SetMode("plan")
	} else if m.cfg.State.GetMode() == "plan" {
		m.cfg.State.SetMode("normal")
	}
	m.footer = presentation.BuildFooterState(m.cfg.State, m.cfg.WorkDir)
	m.applyPresentationEvent(presentation.Event{
		Kind: presentation.EventNotice,
		Text: fmt.Sprintf("permission mode -> %s", next),
	})
	m.refreshViewport(true)
}

func (m *uiModel) enqueueModal(md modalState) {
	if m.modal.Kind == modalNone {
		m.modal = md
		return
	}
	m.modalQueue = append(m.modalQueue, md)
}

func (m *uiModel) closeModal() {
	m.modal = modalState{}
	if len(m.modalQueue) > 0 {
		m.modal = m.modalQueue[0]
		m.modalQueue = m.modalQueue[1:]
	}
}

func (m *uiModel) handleModalKey(msg tea.KeyMsg) {
	switch m.modal.Kind {
	case modalApproval, modalConfirm:
		switch msg.String() {
		case "y", "Y":
			if m.modal.DecisionC != nil {
				m.modal.DecisionC <- decisionResult{Allow: true}
			}
			m.closeModal()
		case "n", "N":
			if m.modal.DecisionC != nil {
				m.modal.DecisionC <- decisionResult{Allow: false}
			}
			m.closeModal()
		case "enter":
			allow := true
			if m.modal.DefaultNo {
				allow = false
			}
			if m.modal.DecisionC != nil {
				m.modal.DecisionC <- decisionResult{Allow: allow}
			}
			m.closeModal()
		case "esc":
			if m.modal.DecisionC != nil {
				m.modal.DecisionC <- decisionResult{Allow: false}
			}
			m.closeModal()
		}
	case modalPassword:
		switch msg.String() {
		case "enter":
			if m.modal.PasswordC != nil {
				m.modal.PasswordC <- passwordResult{Value: m.modal.Password}
			}
			m.closeModal()
		case "esc":
			if m.modal.PasswordC != nil {
				m.modal.PasswordC <- passwordResult{Err: errors.New("password input canceled")}
			}
			m.closeModal()
		case "backspace":
			if len(m.modal.Password) > 0 {
				m.modal.Password = m.modal.Password[:len(m.modal.Password)-1]
			}
		default:
			if len(msg.Runes) > 0 {
				m.modal.Password += string(msg.Runes)
			}
		}
	}
}

func (m *uiModel) applyPresentationEvent(evt presentation.Event) {
	switch evt.Kind {
	case presentation.EventState:
		m.footer = evt.Footer
		return
	case presentation.EventViewCleared:
		m.entries = m.entries[:0]
		m.assistantOpen = false
		m.assistantStreamIdx = -1
		return
	case presentation.EventAssistantDelta:
		m.appendAssistantDelta(evt.Text)
		return
	case presentation.EventAssistantDone:
		m.assistantOpen = false
		m.assistantStreamIdx = -1
		return
	}

	if m.assistantOpen {
		m.assistantOpen = false
		m.assistantStreamIdx = -1
	}

	switch evt.Kind {
	case presentation.EventUser:
		m.appendEntry("user", "You", evt.Text)
	case presentation.EventAssistantText:
		m.appendEntry("assistant", "Assistant", evt.Text)
	case presentation.EventToolUse:
		body := strings.TrimSpace(evt.Input)
		if body == "" {
			body = "(no input)"
		}
		m.appendEntry("tool_use", "Tool Use: "+evt.ToolName, body)
	case presentation.EventToolResult:
		m.appendEntry("tool_result", "Tool Result: "+emptyFallback(evt.ToolName, "-"), evt.Text)
	case presentation.EventNotice:
		m.appendEntry("notice", "Notice", evt.Text)
	case presentation.EventSystem:
		m.appendEntry("system", "System", evt.Text)
	case presentation.EventError:
		m.appendEntry("error", "Error", evt.Text)
	case presentation.EventApprovalRequest:
		body := "tool: " + evt.ToolName
		if strings.TrimSpace(evt.Input) != "" {
			body += "\n" + evt.Input
		}
		m.appendEntry("approval", "Permission Required", body)
	case presentation.EventApprovalDecision:
		m.appendEntry("approval", "Permission Decision", evt.Decision)
	case presentation.EventPasswordRequest:
		body := strings.TrimSpace(evt.Prompt)
		if body == "" {
			body = "Password:"
		}
		m.appendEntry("password", "Password Prompt", body)
	case presentation.EventPlanReady:
		m.appendEntry("plan", "Plan Ready", fmt.Sprintf("approved steps: %d", evt.Count))
	case presentation.EventPlanStep:
		m.appendEntry("plan", fmt.Sprintf("Plan Step %d/%d", evt.StepIndex, evt.StepTotal), fmt.Sprintf("%s: %s", evt.ToolName, evt.Text))
	case presentation.EventPlanDecision:
		m.appendEntry("plan", fmt.Sprintf("Plan Decision %d/%d", evt.StepIndex, evt.StepTotal), evt.Decision)
	case presentation.EventPlanResult:
		m.appendEntry("plan", fmt.Sprintf("Plan Result %d/%d", evt.StepIndex, evt.StepTotal), evt.Text)
	}
}

func (m *uiModel) appendAssistantDelta(delta string) {
	if !m.assistantOpen || m.assistantStreamIdx < 0 || m.assistantStreamIdx >= len(m.entries) {
		m.entries = append(m.entries, transcriptEntry{
			Kind:  "assistant",
			Title: "Assistant",
			Body:  delta,
		})
		m.assistantOpen = true
		m.assistantStreamIdx = len(m.entries) - 1
		return
	}
	m.entries[m.assistantStreamIdx].Body += delta
}

func (m *uiModel) appendEntry(kind, title, body string) {
	m.entries = append(m.entries, transcriptEntry{
		Kind:  kind,
		Title: title,
		Body:  strings.TrimSpace(body),
	})
}

func (m *uiModel) refreshViewport(forceBottom bool) {
	atBottom := m.viewport.AtBottom()
	m.viewport.SetContent(m.renderTranscript())
	if forceBottom || atBottom {
		m.viewport.GotoBottom()
	}
}

func (m *uiModel) resize() {
	if m.width <= 0 || m.height <= 0 {
		return
	}
	inputWidth := m.width - 6
	if inputWidth < 16 {
		inputWidth = 16
	}
	m.input.SetWidth(inputWidth)

	inputHeight := lipgloss.Height(m.renderInput())
	footerHeight := lipgloss.Height(m.renderFooter())
	modalHeight := 0
	if m.modal.Kind != modalNone {
		modalHeight = lipgloss.Height(m.renderModal())
	}
	viewportHeight := m.height - inputHeight - footerHeight - modalHeight
	if viewportHeight < 3 {
		viewportHeight = 3
	}
	m.viewport.Width = m.width - 2
	m.viewport.Height = viewportHeight
	m.refreshViewport(false)
}

func (m uiModel) View() string {
	if m.width == 0 || m.height == 0 {
		return "loading..."
	}
	sections := []string{m.renderViewport()}
	if m.modal.Kind != modalNone {
		sections = append(sections, m.renderModal())
	}
	sections = append(sections, m.renderInput(), m.renderFooter())

	out := lipgloss.JoinVertical(lipgloss.Left, sections...)
	if gap := m.height - lipgloss.Height(out); gap > 0 {
		out += strings.Repeat("\n", gap)
	}
	return out
}
