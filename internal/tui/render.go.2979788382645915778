// renderUserEntry renders a user message with "> " marker and gray background.
func (m uiModel) renderUserEntry(body string, termW int) string {
	if m.theme.DisableANSI {
		return "> " + wordwrap.String(body, termW)
	}

	bg := lipgloss.Color(m.theme.UserBubbleBg)
	hasBg := m.theme.UserBubbleBg != ""

	markerS := lipgloss.NewStyle().
		Foreground(lipgloss.Color(m.theme.UserMarkerColor))
	textS := lipgloss.NewStyle().
		Foreground(lipgloss.Color(m.theme.UserBubbleFg))

	if hasBg {
		markerS = markerS.Background(bg)
		textS = textS.Background(bg)
	}

	wrappedBody := wordwrap.String(body, termW-2)
	lines := strings.Split(wrappedBody, "\n")
	out := make([]string, len(lines))
	for i, line := range lines {
		var prefix string
		if i == 0 {
			prefix = markerS.Render("> ")
		} else {
			prefix = textS.Render("  ")
		}
		content := textS.Render(line)

		var fullLine string
		if hasBg {
			visible := lipgloss.Width(prefix) + lipgloss.Width(content)
			pad := m.width - visible
			if pad < 0 {
				pad = 0
			}
			fullLine = prefix + content + textS.Render(strings.Repeat(" ", pad))
		} else {
			fullLine = prefix + content
		}
		out[i] = fullLine
	}

	// gemini-cli style HalfLinePaddedBox implementation
	topStyle := lipgloss.NewStyle().Foreground(lipgloss.Color(m.theme.MutedColor))
	bottomStyle := lipgloss.NewStyle().Foreground(lipgloss.Color(m.theme.MutedColor))

	if hasBg {
		topStyle = topStyle.Background(bg)
		bottomStyle = bottomStyle.Background(bg)
	}

	topBorder := topStyle.Render(strings.Repeat("-", m.width))
	bottomBorder := bottomStyle.Render(strings.Repeat("-", m.width))

	return strings.Join([]string{topBorder, strings.Join(out, "\n"), bottomBorder}, "\n")
}

// renderAssistantEntry wraps a rendered body with the ??marker.
func (m uiModel) renderAssistantEntry(body string) string {
	if m.theme.DisableANSI {
		return body
	}
	marker := lipgloss.NewStyle().
		Foreground(lipgloss.Color(m.theme.AssistantMarkerColor)).
		Render("??")
	lines := strings.Split(body, "\n")
	out := make([]string, len(lines))
	for i, line := range lines {
		if i == 0 {
			out[i] = marker + line
		} else {
			out[i] = "  " + line
		}
	}
	return strings.Join(out, "\n")
}

