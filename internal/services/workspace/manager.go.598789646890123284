package workspace

import (
	"context"
	"encoding/base64"
	"fmt"
	"os"
	"path/filepath"
	"strings"
	"sync"
	"time"
)

type PasswordRequestFunc func(alias, kind, prompt string) (string, error)

type Manager struct {
	reg *Registry

	mu       sync.RWMutex
	sessions map[string]*sshSession
	pwCache  map[string]map[string]string
	promptFn PasswordRequestFunc
}

func NewManager(reg *Registry, promptFn PasswordRequestFunc) *Manager {
	if reg == nil {
		reg = NewRegistry("")
	}
	return &Manager{
		reg:      reg,
		sessions: make(map[string]*sshSession),
		pwCache:  make(map[string]map[string]string),
		promptFn: promptFn,
	}
}

func (m *Manager) Registry() *Registry {
	return m.reg
}

func (m *Manager) SetPromptFunc(promptFn PasswordRequestFunc) {
	m.mu.Lock()
	defer m.mu.Unlock()
	m.promptFn = promptFn
}

func (m *Manager) ActiveAlias() string {
	return m.reg.Active()
}

func (m *Manager) ResolveAlias(alias string) string {
	trimmed := strings.TrimSpace(strings.ToLower(alias))
	if trimmed == "" {
		return m.ActiveAlias()
	}
	return trimmed
}

func (m *Manager) SetActive(alias string) error {
	if err := m.reg.SetActive(alias); err != nil {
		return err
	}
	return m.reg.Save()
}

func (m *Manager) Status() []StatusEntry {
	active := m.ActiveAlias()
	entries := m.reg.List()
	out := make([]StatusEntry, 0, len(entries))
	for _, entry := range entries {
		st := StatusEntry{
			Alias:  entry.Alias,
			Kind:   entry.Kind,
			Active: entry.Alias == active,
		}
		if entry.Kind == ServerKindLocal {
			st.Connected = true
			if wd, err := os.Getwd(); err == nil {
				st.CurrentCWD = wd
			}
			st.User = os.Getenv("USERNAME")
			out = append(out, st)
			continue
		}
		if s := m.getSession(entry.Alias); s != nil {
			st.Connected = true
			st.CurrentCWD = s.currentCWD()
			st.User = s.currentUser()
		}
		out = append(out, st)
	}
	return out
}

func (m *Manager) Connect(alias string) error {
	alias = m.ResolveAlias(alias)
	if alias == LocalAlias {
		return nil
	}

	entry, ok := m.reg.Get(alias)
	if !ok {
		return fmt.Errorf("unknown server alias: %s", alias)
	}
	if entry.Kind != ServerKindSSH {
		return fmt.Errorf("unsupported server kind for connect: %s", entry.Kind)
	}
	if existing := m.getSession(alias); existing != nil {
		return nil
	}

	session, err := newSSHSession(entry, m.requestPassword)
	if err != nil {
		return err
	}
	m.mu.Lock()
	m.sessions[alias] = session
	m.mu.Unlock()
	return nil
}

func (m *Manager) Disconnect(alias string) error {
	alias = m.ResolveAlias(alias)
	if alias == LocalAlias {
		return nil
	}

	var session *sshSession
	m.mu.Lock()
	session = m.sessions[alias]
	delete(m.sessions, alias)
	delete(m.pwCache, alias)
	m.mu.Unlock()

	if session != nil {
		return session.Close()
	}
	return nil
}

func (m *Manager) DisconnectAll() error {
	m.mu.Lock()
	sessions := make([]*sshSession, 0, len(m.sessions))
	for _, s := range m.sessions {
		sessions = append(sessions, s)
	}
	m.sessions = make(map[string]*sshSession)
	m.pwCache = make(map[string]map[string]string)
	m.mu.Unlock()

	var firstErr error
	for _, s := range sessions {
		if err := s.Close(); err != nil && firstErr == nil {
			firstErr = err
		}
	}
	return firstErr
}

func (m *Manager) IsRemoteAlias(alias string) bool {
	alias = m.ResolveAlias(alias)
	entry, ok := m.reg.Get(alias)
	return ok && entry.Kind == ServerKindSSH
}

func (m *Manager) SetPassword(alias, kind, password string) {
	m.mu.Lock()
	defer m.mu.Unlock()
	if m.pwCache[alias] == nil {
		m.pwCache[alias] = make(map[string]string)
	}
	m.pwCache[alias][kind] = password
}

func (m *Manager) Exec(ctx context.Context, alias, command string, subQuery ExecuteSubQueryFunc) (ExecResult, error) {
	return m.ExecWithOptions(ctx, alias, command, ExecOptions{}, subQuery)
}

func (m *Manager) ExecWithOptions(ctx context.Context, alias, command string, opts ExecOptions, subQuery ExecuteSubQueryFunc) (ExecResult, error) {
	alias = m.ResolveAlias(alias)
	entry, ok := m.reg.Get(alias)
	if !ok {
		return ExecResult{}, fmt.Errorf("unknown server alias: %s", alias)
	}
	if strings.TrimSpace(command) == "" {
		return ExecResult{}, fmt.Errorf("command is empty")
	}

	if entry.Kind == ServerKindLocal {
		return m.execLocal(ctx, command)
	}

	session, err := m.ensureSession(alias)
	if err != nil {
		return ExecResult{}, err
	}
	return session.Exec(ctx, command, opts, subQuery)
}

func (m *Manager) ReadFile(ctx context.Context, alias, path string) ([]byte, error) {
	alias = m.ResolveAlias(alias)
	if alias == LocalAlias {
		return os.ReadFile(path)
	}

	session, err := m.ensureSession(alias)
	if err != nil {
		return nil, err
	}
	data, sftpErr := session.readFileSFTP(path)
	if sftpErr == nil {
		return data, nil
	}
	data, cmdErr := m.readFileByCommand(ctx, alias, path)
	if cmdErr == nil {
		return data, nil
	}
	return nil, fmt.Errorf("read remote file failed (sftp: %v, shell fallback: %v)", sftpErr, cmdErr)
}

func (m *Manager) WriteFile(ctx context.Context, alias, path string, content []byte, overwrite bool) error {
	alias = m.ResolveAlias(alias)
	if alias == LocalAlias {
		if !overwrite {
			if _, err := os.Stat(path); err == nil {
				return fmt.Errorf("destination already exists: %s", path)
			}
		}
		if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
			return err
		}
		return os.WriteFile(path, content, 0o644)
	}

	session, err := m.ensureSession(alias)
	if err != nil {
		return err
	}
	if err := session.writeFileSFTP(path, content, overwrite); err == nil {
		return nil
	}
	return m.writeFileByCommand(ctx, alias, path, content, overwrite)
}

func (m *Manager) UploadFile(ctx context.Context, alias, localPath, remotePath string, overwrite bool) error {
	alias = m.ResolveAlias(alias)
	if alias == LocalAlias {
		return fmt.Errorf("upload target must be a remote server alias")
	}
	session, err := m.ensureSession(alias)
	if err != nil {
		return err
	}
	if err := session.uploadFileSFTP(localPath, remotePath, overwrite); err == nil {
		return nil
	}
	content, err := os.ReadFile(localPath)
	if err != nil {
		return err
	}
	return m.writeFileByCommand(ctx, alias, remotePath, content, overwrite)
}

func (m *Manager) DownloadFile(ctx context.Context, alias, remotePath, localPath string, overwrite bool) error {
	alias = m.ResolveAlias(alias)
	if alias == LocalAlias {
		return fmt.Errorf("download source must be a remote server alias")
	}
	session, err := m.ensureSession(alias)
	if err != nil {
		return err
	}
	if err := session.downloadFileSFTP(remotePath, localPath, overwrite); err == nil {
		return nil
	}
	content, err := m.readFileByCommand(ctx, alias, remotePath)
	if err != nil {
		return err
	}
	if !overwrite {
		if _, err := os.Stat(localPath); err == nil {
			return fmt.Errorf("destination already exists: %s", localPath)
		}
	}
	if err := os.MkdirAll(filepath.Dir(localPath), 0o755); err != nil {
		return err
	}
	return os.WriteFile(localPath, content, 0o644)
}

func (m *Manager) CopyFile(ctx context.Context, srcAlias, srcPath, dstAlias, dstPath string, overwrite bool) error {
	srcAlias = m.ResolveAlias(srcAlias)
	dstAlias = m.ResolveAlias(dstAlias)

	if srcAlias == LocalAlias && dstAlias != LocalAlias {
		return m.UploadFile(ctx, dstAlias, srcPath, dstPath, overwrite)
	}
	if srcAlias != LocalAlias && dstAlias == LocalAlias {
		return m.DownloadFile(ctx, srcAlias, srcPath, dstPath, overwrite)
	}

	data, err := m.ReadFile(ctx, srcAlias, srcPath)
	if err != nil {
		return err
	}
	return m.WriteFile(ctx, dstAlias, dstPath, data, overwrite)
}

func (m *Manager) OpenTunnel(ctx context.Context, alias, localAddr, remoteAddr string) (TunnelInfo, error) {
	_ = ctx
	alias = m.ResolveAlias(alias)
	if alias == LocalAlias {
		return TunnelInfo{}, fmt.Errorf("tunneling requires a remote server alias")
	}
	session, err := m.ensureSession(alias)
	if err != nil {
		return TunnelInfo{}, err
	}
	return session.openTunnel(localAddr, remoteAddr)
}

func (m *Manager) CloseTunnel(alias, tunnelID string) error {
	alias = m.ResolveAlias(alias)
	if alias == LocalAlias {
		return fmt.Errorf("tunneling requires a remote server alias")
	}
	session := m.getSession(alias)
	if session == nil {
		return fmt.Errorf("ssh session unavailable for %s", alias)
	}
	return session.closeTunnel(tunnelID)
}

func (m *Manager) ListTunnels(alias string) ([]TunnelInfo, error) {
	alias = m.ResolveAlias(alias)
	if alias == LocalAlias {
		return nil, fmt.Errorf("tunneling requires a remote server alias")
	}
	session := m.getSession(alias)
	if session == nil {
		return nil, fmt.Errorf("ssh session unavailable for %s", alias)
	}
	return session.listTunnels(), nil
}

func (m *Manager) MetricsSnapshot(ctx context.Context, alias string) (MetricsSnapshot, error) {
	alias = m.ResolveAlias(alias)
	if alias == LocalAlias {
		return MetricsSnapshot{}, fmt.Errorf("metrics snapshot requires a remote server alias")
	}

	metricCommands := map[string]string{
		"load":      "cat /proc/loadavg 2>/dev/null | awk '{print $1\" \"$2\" \"$3}'",
		"cpu":       "lscpu 2>/dev/null",
		"memory":    "free -h 2>/dev/null || vm_stat 2>/dev/null",
		"disk":      "df -h 2>/dev/null",
		"uptime":    "uptime 2>/dev/null",
		"processes": "ps -eo pid,ppid,pcpu,pmem,comm --sort=-pcpu 2>/dev/null | head -n 15",
		"gpu":       "nvidia-smi --query-gpu=name,utilization.gpu,memory.used,memory.total --format=csv,noheader 2>/dev/null",
	}

	snapshot := MetricsSnapshot{
		Alias:       alias,
		CollectedAt: time.Now(),
		Errors:      make(map[string]string),
	}

	var wg sync.WaitGroup
	var outMu sync.Mutex
	for key, cmd := range metricCommands {
		wg.Add(1)
		go func(field, command string) {
			defer wg.Done()
			res, err := m.ExecWithOptions(ctx, alias, command, ExecOptions{}, nil)
			outMu.Lock()
			defer outMu.Unlock()
			if err != nil {
				snapshot.Errors[field] = err.Error()
				return
			}
			if res.Code != 0 {
				snapshot.Errors[field] = strings.TrimSpace(res.Stdout + "\n" + res.Stderr)
				return
			}
			out := strings.TrimSpace(res.Stdout)
			switch field {
			case "load":
				snapshot.Load = out
			case "cpu":
				snapshot.CPU = out
			case "memory":
				snapshot.Memory = out
			case "disk":
				snapshot.Disk = out
			case "uptime":
				snapshot.Uptime = out
			case "processes":
				snapshot.Processes = out
			case "gpu":
				snapshot.GPU = out
			}
		}(key, cmd)
	}
	wg.Wait()

	nonEmpty := snapshot.Load != "" || snapshot.CPU != "" || snapshot.Memory != "" || snapshot.Disk != "" || snapshot.Uptime != "" || snapshot.Processes != "" || snapshot.GPU != ""
	if !nonEmpty {
		return MetricsSnapshot{}, fmt.Errorf("failed to collect metrics for %s", alias)
	}
	if len(snapshot.Errors) == 0 {
		snapshot.Errors = nil
	}
	return snapshot, nil
}

func (m *Manager) readFileByCommand(ctx context.Context, alias, path string) ([]byte, error) {
	quoted := shellQuote(path)
	cmd := fmt.Sprintf("if [ ! -f %s ]; then echo '__ARGUS_FILE_ERROR__:not_file'; exit 66; fi; base64 < %s", quoted, quoted)
	res, err := m.ExecWithOptions(ctx, alias, cmd, ExecOptions{}, nil)
	if err != nil {
		return nil, err
	}
	if res.Code != 0 {
		return nil, fmt.Errorf("read remote file failed: %s", strings.TrimSpace(res.Stdout+res.Stderr))
	}
	out := strings.TrimSpace(res.Stdout)
	if strings.Contains(out, "__ARGUS_FILE_ERROR__") {
		return nil, fmt.Errorf("not a file: %s", path)
	}
	return base64.StdEncoding.DecodeString(out)
}

func (m *Manager) writeFileByCommand(ctx context.Context, alias, path string, content []byte, overwrite bool) error {
	if !overwrite {
		checkCmd := fmt.Sprintf("if [ -e %s ]; then echo 'exists'; exit 17; fi", shellQuote(path))
		res, err := m.ExecWithOptions(ctx, alias, checkCmd, ExecOptions{}, nil)
		if err != nil {
			return err
		}
		if res.Code == 17 {
			return fmt.Errorf("destination already exists: %s", path)
		}
	}

	b64 := base64.StdEncoding.EncodeToString(content)
	delim := fmt.Sprintf("__ARGUS_DATA_%d__", time.Now().UnixNano())
	cmd := strings.Join([]string{
		fmt.Sprintf("mkdir -p $(dirname %s)", shellQuote(path)),
		fmt.Sprintf("cat <<'%s' | base64 -d > %s", delim, shellQuote(path)),
		b64,
		delim,
	}, "\n")
	res, err := m.ExecWithOptions(ctx, alias, cmd, ExecOptions{}, nil)
	if err != nil {
		return err
	}
	if res.Code != 0 {
		return fmt.Errorf("write remote file failed: %s", strings.TrimSpace(res.Stdout+res.Stderr))
	}
	return nil
}

func (m *Manager) ensureSession(alias string) (*sshSession, error) {
	if err := m.Connect(alias); err != nil {
		return nil, err
	}
	session := m.getSession(alias)
	if session == nil {
		return nil, fmt.Errorf("ssh session unavailable for %s", alias)
	}
	return session, nil
}

func (m *Manager) getSession(alias string) *sshSession {
	m.mu.RLock()
	defer m.mu.RUnlock()
	return m.sessions[alias]
}

func (m *Manager) requestPassword(alias, kind, prompt string) (string, error) {
	cached := m.cachedPassword(alias, kind)
	if cached != "" {
		return cached, nil
	}
	m.mu.RLock()
	fn := m.promptFn
	m.mu.RUnlock()
	if fn == nil {
		return "", fmt.Errorf("password required for %s (%s) but no prompt callback is configured", alias, kind)
	}
	pw, err := fn(alias, kind, prompt)
	if err != nil {
		return "", err
	}
	if strings.TrimSpace(pw) != "" {
		m.cachePassword(alias, kind, pw)
	}
	return pw, nil
}

func (m *Manager) cachePassword(alias, kind, password string) {
	m.mu.Lock()
	defer m.mu.Unlock()
	if m.pwCache[alias] == nil {
		m.pwCache[alias] = make(map[string]string)
	}
	m.pwCache[alias][kind] = password
}

func (m *Manager) cachedPassword(alias, kind string) string {
	m.mu.RLock()
	defer m.mu.RUnlock()
	if m.pwCache[alias] == nil {
		return ""
	}
	return m.pwCache[alias][kind]
}

