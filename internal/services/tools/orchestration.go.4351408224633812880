package tools

import (
	"context"
	"encoding/json"
	"fmt"
	"sync"

	"github.com/koreaf16/argus/internal/hooks"
	"github.com/koreaf16/argus/internal/services/llm"
	tool "github.com/koreaf16/argus/internal/tools"
	"github.com/koreaf16/argus/internal/types"
)

// ToolResult stores one tool call execution result.
type ToolResult struct {
	Call    llm.ToolUseStart
	Output  string
	IsError bool
}

// toolBatch groups tool calls by whether they are safe to run concurrently.
type toolBatch struct {
	IsConcurrencySafe bool
	Calls             []llm.ToolUseStart
}

// ConcurrencySafetyEvaluator is optional for tools that need input-aware
// concurrency checks (for example shell tools with read-only commands).
type ConcurrencySafetyEvaluator interface {
	IsConcurrencySafe(input json.RawMessage) bool
}

// PartitionToolCalls partitions tool calls into concurrent-safe and sequential batches.
func PartitionToolCalls(calls []llm.ToolUseStart, registry *tool.Registry) []toolBatch {
	var batches []toolBatch

	for _, call := range calls {
		isSafe := isCallConcurrencySafe(call, registry)

		if isSafe && len(batches) > 0 && batches[len(batches)-1].IsConcurrencySafe {
			batches[len(batches)-1].Calls = append(batches[len(batches)-1].Calls, call)
		} else {
			batches = append(batches, toolBatch{
				IsConcurrencySafe: isSafe,
				Calls:             []llm.ToolUseStart{call},
			})
		}
	}

	return batches
}

func isCallConcurrencySafe(call llm.ToolUseStart, registry *tool.Registry) bool {
	if registry == nil {
		return false
	}
	t, ok := registry.Lookup(call.Name)
	if !ok {
		return false
	}
	if evaluator, ok := t.(ConcurrencySafetyEvaluator); ok {
		return evaluator.IsConcurrencySafe(call.Input)
	}
	return t.IsReadOnly()
}

// RunTools orchestrates tool calls with hook support.
func RunTools(
	ctx context.Context,
	toolCalls []llm.ToolUseStart,
	registry *tool.Registry,
	hookRegistry *HookRegistry,
	executor func(context.Context, llm.ToolUseStart) (string, bool),
) []ToolResult {
	return RunToolsWithDispatcher(ctx, toolCalls, registry, hookRegistry, nil, executor)
}

// RunToolsWithDispatcher orchestrates tool calls with optional settings hook dispatch.
func RunToolsWithDispatcher(
	ctx context.Context,
	toolCalls []llm.ToolUseStart,
	registry *tool.Registry,
	hookRegistry *HookRegistry,
	dispatcher *hooks.HookDispatcher,
	executor func(context.Context, llm.ToolUseStart) (string, bool),
) []ToolResult {
	var results []ToolResult
	batches := PartitionToolCalls(toolCalls, registry)

	for _, batch := range batches {
		if batch.IsConcurrencySafe {
			var wg sync.WaitGroup
			batchResults := make([]ToolResult, len(batch.Calls))

			for i, call := range batch.Calls {
				wg.Add(1)
				go func(index int, c llm.ToolUseStart) {
					defer wg.Done()

					if hookRegistry != nil {
						_ = hookRegistry.RunPreHooks(ctx, c)
					}

					if blocked, msg := runPreDispatch(ctx, dispatcher, c); blocked {
						batchResults[index] = ToolResult{Call: c, Output: msg, IsError: true}
						return
					}

					res, isErr := executor(ctx, c)

					if hookRegistry != nil {
						_ = hookRegistry.RunPostHooks(ctx, c, res, isErr)
					}

					runPostDispatch(ctx, dispatcher, c, res, isErr)

					batchResults[index] = ToolResult{
						Call:    c,
						Output:  res,
						IsError: isErr,
					}
				}(i, call)
			}
			wg.Wait()
			results = append(results, batchResults...)
		} else {
			for _, call := range batch.Calls {
				if hookRegistry != nil {
					_ = hookRegistry.RunPreHooks(ctx, call)
				}

				if blocked, msg := runPreDispatch(ctx, dispatcher, call); blocked {
					results = append(results, ToolResult{Call: call, Output: msg, IsError: true})
					continue
				}

				res, isErr := executor(ctx, call)

				if hookRegistry != nil {
					_ = hookRegistry.RunPostHooks(ctx, call, res, isErr)
				}

				runPostDispatch(ctx, dispatcher, call, res, isErr)

				results = append(results, ToolResult{
					Call:    call,
					Output:  res,
					IsError: isErr,
				})
			}
		}
	}

	return results
}

// runPreDispatch executes PreToolUse hooks and returns a block reason when blocked.
func runPreDispatch(ctx context.Context, dispatcher *hooks.HookDispatcher, call llm.ToolUseStart) (blocked bool, msg string) {
	if dispatcher == nil || dispatcher.IsEmpty() {
		return false, ""
	}

	inputJSON := marshalToolInput(call.Input)
	agg := dispatcher.Dispatch(ctx, types.HookEventPreToolUse, hooks.HookInput{
		ToolName:      call.Name,
		ToolInputJSON: inputJSON,
	})

	if !agg.Continue {
		reason := agg.BlockReason
		if reason == "" {
			reason = agg.StopReason
		}
		if reason == "" {
			reason = fmt.Sprintf("PreToolUse hook blocked tool: %s", call.Name)
		}
		return true, reason
	}
	return false, ""
}

// runPostDispatch executes PostToolUse/PostToolUseFailure hooks.
func runPostDispatch(ctx context.Context, dispatcher *hooks.HookDispatcher, call llm.ToolUseStart, result string, isErr bool) {
	if dispatcher == nil || dispatcher.IsEmpty() {
		return
	}

	event := types.HookEventPostToolUse
	if isErr {
		event = types.HookEventPostToolUseFailure
	}

	inputJSON := marshalToolInput(call.Input)
	dispatcher.Dispatch(ctx, event, hooks.HookInput{
		ToolName:      call.Name,
		ToolInputJSON: inputJSON,
		ToolResult:    result,
		IsToolError:   isErr,
	})
}

func marshalToolInput(input json.RawMessage) string {
	if len(input) == 0 {
		return "{}"
	}
	return string(input)
}
