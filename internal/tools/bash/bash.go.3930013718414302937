func stripRedundantPrivilegeWrapper(command, currentUser string) string {
	trimmedCmd := strings.TrimSpace(command)
	current := strings.TrimSpace(currentUser)
	if trimmedCmd == "" || current == "" {
		return trimmedCmd
	}

	if strings.HasPrefix(trimmedCmd, "su ") || strings.HasPrefix(trimmedCmd, "sudo ") {
		targetUser, cmdBody := parseTargetUser(trimmedCmd)
		if targetUser != "" && strings.EqualFold(strings.TrimSpace(targetUser), current) && strings.TrimSpace(cmdBody) != "" {
			return strings.TrimSpace(cmdBody)
		}
	}
	return trimmedCmd
}

func parseTargetUser(cmd string) (user, body string) {
	trimmed := strings.TrimSpace(cmd)
	if strings.HasPrefix(trimmed, "su ") {
		// su [-] [user] [-c "cmd"]
		parts := strings.Fields(trimmed)
		user = "root" // 湲곕낯媛?		body = ""
		for i := 1; i < len(parts); i++ {
			p := parts[i]
			if p == "-" || p == "-l" || p == "--login" {
				continue
			}
			if p == "-c" {
				if i+1 < len(parts) {
					body = strings.Join(parts[i+1:], " ")
					// ?곗샂???쒓굅
					body = strings.Trim(body, "'\"")
				}
				break
			}
			if !strings.HasPrefix(p, "-") {
				user = p
			}
		}
		return user, body
	}

	if strings.HasPrefix(trimmed, "sudo ") {
		// sudo [-u user] cmd
		parts := strings.Fields(trimmed)
		user = "root" // 湲곕낯媛?		body = ""
		for i := 1; i < len(parts); i++ {
			p := parts[i]
			if p == "-u" {
				if i+1 < len(parts) {
					user = parts[i+1]
					i++
					continue
				}
			}
			if !strings.HasPrefix(p, "-") {
				body = strings.Join(parts[i:], " ")
				break
			}
		}
		return user, body
	}
	return "", ""
}
