// Package session provides session ID and snapshot helpers.
//
// File role: Defines the persisted session snapshot schema and a UUIDv4-style
// session ID generator for new Argus sessions.
// Included modules:
//   - Snapshot: Persisted conversation payload for resume.
//   - NewID: Creates a random UUIDv4 session ID string.
// Calls/usage:
//   - cmd/argus/main.go uses NewID and Snapshot for bootstrap/persistence.
//   - internal/repl/commands/dispatcher.go uses Snapshot for /session save/load.
// Connections:
//   - Imports internal/services/llm for message schema compatibility.
package session

import (
	"crypto/rand"
	"fmt"
	"time"

	"github.com/koreaf16/argus/internal/services/llm"
)

// Snapshot is the persisted session payload.
type Snapshot struct {
	SavedAt  time.Time     `json:"saved_at"`
	Messages []llm.Message `json:"messages"`
}

// NewID returns a UUIDv4-compatible session ID.
func NewID() (string, error) {
	var b [16]byte
	if _, err := rand.Read(b[:]); err != nil {
		return "", err
	}
	b[6] = (b[6] & 0x0f) | 0x40
	b[8] = (b[8] & 0x3f) | 0x80
	return fmt.Sprintf(
		"%02x%02x%02x%02x-%02x%02x-%02x%02x-%02x%02x-%02x%02x%02x%02x%02x%02x",
		b[0], b[1], b[2], b[3],
		b[4], b[5],
		b[6], b[7],
		b[8], b[9],
		b[10], b[11], b[12], b[13], b[14], b[15],
	), nil
}
