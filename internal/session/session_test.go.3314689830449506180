package session

import "testing"

func TestNewIDUUIDv4Format(t *testing.T) {
	id, err := NewID()
	if err != nil {
		t.Fatalf("new id: %v", err)
	}
	if len(id) != 36 {
		t.Fatalf("expected length 36, got %d (%q)", len(id), id)
	}
	if id[8] != '-' || id[13] != '-' || id[18] != '-' || id[23] != '-' {
		t.Fatalf("invalid UUID separators: %q", id)
	}
	if id[14] != '4' {
		t.Fatalf("expected UUIDv4 variant nibble at index 14, got %q", string(id[14]))
	}
	switch id[19] {
	case '8', '9', 'a', 'b':
	default:
		t.Fatalf("expected RFC4122 variant at index 19, got %q", string(id[19]))
	}
}

