// Package logo — Argus 브랜드 아이콘 및 condensed 로고 렌더러.
//
// 파일 역할: 세션 시작 시 스크롤백에 1회 출력되는 CondensedLogo 블록을 렌더링한다.
//   [아이콘]  Argus v0.x.x
//             model with high effort · provider
//             /path/to/cwd
// 포함 모듈:
//   - Data: 로고에 필요한 데이터 구조체.
//   - Render(d Data, aiDebug bool) string: 완성된 로고 문자열 반환.
// 호출/사용 방식:
//   - internal/tui/tui.go 에서 세션 시작 시 p.Println() 으로 1회 출력.
//   - internal/tui/render.go 의 renderLogoBlock() 에서 호출.
// 연결:
//   - internal/components/logo/argus_icon.go: 아이콘 렌더러.
//   - github.com/charmbracelet/lipgloss: 스타일링.
//
package logo

import (
	"strings"

	"github.com/charmbracelet/lipgloss"
)

// Data 는 CondensedLogo 렌더에 필요한 데이터다.
type Data struct {
	Version      string
	ModelDisplay string
	EffortLevel  string // "high" / "low" / ""
	ProviderName string // "anthropic" / "gemini" / "openai-compat"
	Cwd          string
	SourcePath   string
	AgentName    string
	Columns      int // 터미널 폭 (truncate 계산용)
}

var dimStyle = lipgloss.NewStyle().Foreground(lipgloss.Color("240"))
var boldStyle = lipgloss.NewStyle().Bold(true)

// Render 는 Argus CondensedLogo 블록 문자열을 반환한다.
func Render(d Data, aiDebug bool) string {
	icon := RenderIcon(aiDebug)

	cols := d.Columns
	if cols <= 0 {
		cols = 80
	}
	// Claude 레이아웃과 동일한 느낌으로 아이콘 우측 칼럼 폭 계산.
	textWidth := cols - 15
	if textWidth < 20 {
		textWidth = 20
	}

	modelDisplay := strings.TrimSpace(d.ModelDisplay)
	if modelDisplay == "" {
		modelDisplay = "unconfigured"
	}

	// 줄 1: "Argus Code v0.x.x"
	ver := truncate(d.Version, textWidth-13)
	line1 := boldStyle.Render("Argus Code v" + ver)

	// 줄 2: "model with high effort · provider"
	modelPart := truncate(modelDisplay, textWidth/2)
	effortPart := ""
	if d.EffortLevel != "" {
		effortPart = " with " + d.EffortLevel + " effort"
	}
	providerPart := ""
	if d.ProviderName != "" {
		providerPart = " · " + d.ProviderName
	}
	line2 := dimStyle.Render(modelPart + effortPart + providerPart)

	// 줄 3: cwd 또는 "@agent · cwd"
	var cwdStr string
	if d.AgentName != "" {
		cwdStr = "@" + d.AgentName + " · " + truncatePath(d.Cwd, textWidth-len(d.AgentName)-4)
	} else {
		cwdStr = truncatePath(d.Cwd, textWidth)
	}
	line3 := dimStyle.Render(cwdStr)

	column := strings.Join([]string{line1, line2, line3}, "\n")

	block := lipgloss.JoinHorizontal(lipgloss.Top, icon, "  ", column)
	sourcePath := strings.TrimSpace(d.SourcePath)
	if sourcePath == "" {
		sourcePath = ".Argus\\settings.json"
	}
	usingLine := dimStyle.Render("Using " + truncate(modelDisplay, textWidth/2) + " (from " + sourcePath + ") · /model to change")
	return strings.Join([]string{block, "", usingLine, ""}, "\n")
}

func truncate(s string, max int) string {
	if max <= 0 {
		return s
	}
	if len(s) <= max {
		return s
	}
	if max <= 1 {
		return "…"
	}
	return s[:max-1] + "…"
}

func truncatePath(p string, max int) string {
	if max <= 0 || len(p) <= max {
		return p
	}
	// 앞쪽 경로 생략: …/last/segment
	parts := strings.Split(p, "/")
	if len(parts) == 1 {
		parts = strings.Split(p, "\\")
	}
	for len(parts) > 1 && len(strings.Join(parts, "/"))+3 > max {
		parts = parts[1:]
	}
	if len(parts) == 0 {
		return truncate(p, max)
	}
	result := strings.Join(parts, "/")
	if len(result) < len(p) {
		result = "…/" + result
	}
	return result
}
