package promptinput

import (
	"strings"

	"github.com/charmbracelet/lipgloss"
)

const (
	promptLineIndicator = "> "
	wrappedLineIndent   = "  "
)

var (
	promptFrameStyle = lipgloss.NewStyle().
			Border(lipgloss.RoundedBorder()).
			BorderForeground(lipgloss.Color("63")).
			Padding(0, 1)
	promptIndicatorStyle = lipgloss.NewStyle().
				Foreground(lipgloss.Color("39")).
				Bold(true)
	promptTextStyle = lipgloss.NewStyle().Foreground(lipgloss.Color("252"))
)

func RenderBaseTextInput(inner string, width int) string {
	if width <= 0 {
		width = 80
	}
	lines := strings.Split(inner, "\n")
	if len(lines) == 0 {
		lines = []string{""}
	}
	for i := range lines {
		prefix := wrappedLineIndent
		if i == 0 {
			prefix = promptLineIndicator
		}
		lines[i] = promptIndicatorStyle.Render(prefix) + promptTextStyle.Render(lines[i])
	}
	frameWidth := width - 4
	if frameWidth < 16 {
		frameWidth = 16
	}
	return promptFrameStyle.Copy().Width(frameWidth).Render(strings.Join(lines, "\n"))
}
