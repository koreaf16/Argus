package promptinput

import (
	"strings"

	"github.com/charmbracelet/lipgloss"
)

const (
	promptLineIndicator = "> "
	wrappedLineIndent   = "  "
)

var (
	promptTopLineStyle = lipgloss.NewStyle().Foreground(lipgloss.Color("244"))
	promptBottomStyle  = lipgloss.NewStyle().Foreground(lipgloss.Color("244"))
	promptIndicatorStyle = lipgloss.NewStyle().
				Foreground(lipgloss.Color("39")).
				Bold(true)
	promptTextStyle = lipgloss.NewStyle().Foreground(lipgloss.Color("252"))
)

func RenderBaseTextInput(inner string, width int) string {
	if width <= 0 {
		width = 80
	}
	if width < 20 {
		width = 20
	}
	lines := strings.Split(inner, "\n")
	if len(lines) == 0 {
		lines = []string{""}
	}
	formatted := make([]string, 0, len(lines))
	for i := range lines {
		prefix := wrappedLineIndent
		if i == 0 {
			prefix = promptLineIndicator
		}
		line := " " + promptIndicatorStyle.Render(prefix) + promptTextStyle.Render(lines[i])
		formatted = append(formatted, fitLineWidth(line, width))
	}
	top := promptTopLineStyle.Render(strings.Repeat("▀", width))
	bottom := promptBottomStyle.Render(strings.Repeat("▄", width))
	return strings.Join([]string{top, strings.Join(formatted, "\n"), bottom}, "\n")
}

func fitLineWidth(line string, width int) string {
	if width <= 0 {
		return line
	}
	if lipgloss.Width(line) > width {
		return trimToWidth(line, width)
	}
	gap := width - lipgloss.Width(line)
	if gap <= 0 {
		return line
	}
	return line + strings.Repeat(" ", gap)
}

func trimToWidth(s string, width int) string {
	if width <= 0 || lipgloss.Width(s) <= width {
		return s
	}
	runes := []rune(s)
	for len(runes) > 0 && lipgloss.Width(string(runes)) > width {
		runes = runes[:len(runes)-1]
	}
	return string(runes)
}
