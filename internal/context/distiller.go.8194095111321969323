package context

import (
	"fmt"
	"strings"
)

const (
	// FullThresholdChars ?????댄븯硫??꾩껜 ?댁슜??inline???ы븿 (FULL).
	FullThresholdChars = 8_000

	// PartialHeadLines ??PARTIAL ???욎뿉??蹂댁〈??以???
	PartialHeadLines = 80
	// PartialTailLines ??PARTIAL ???ㅼ뿉??蹂댁〈??以???
	PartialTailLines = 60

	// SummaryThresholdChars ???대? 珥덇낵?섎㈃ LLM/extractive ?붿빟???쒕룄 (SUMMARY).
	// 250k 珥덇낵??extractive only.
	SummaryThresholdChars = 20_000

	// LLMSummaryMaxChars ??LLM ?붿빟???쒕룄??理쒕? ?먮낯 ?ш린. 珥덇낵 ??extractive only.
	LLMSummaryMaxChars = 250_000

	// MaxInlineChars ??inline ?띿뒪?몄쓽 理쒕? ?덉슜 ?ш린.
	MaxInlineChars = FullThresholdChars
)

// DistillResult ??Distill() ??寃곌낵??
type DistillResult struct {
	InlineText string     // context???ы븿???띿뒪??	Projection Projection // ?뺤텞 ?섏?
	ArtifactID string     // ArtifactStore????(?앹꽦??寃쎌슦)
	ArtifactPath string   // ?뚯씪 寃쎈줈
}

// Distiller ??tool output???뺤텞?쒕떎.
type Distiller struct {
	store       *ArtifactStore
	manifest    *ArtifactManifest
	// summarizer媛 二쇱엯?섎㈃ LLM ?붿빟 ?쒕룄; nil?대㈃ extractive only
	summarizeFn func(toolName, content string) (string, error)
}

// NewDistiller ????Distiller瑜?諛섑솚?쒕떎.
// summarizeFn ??nil?대㈃ extractive ?붿빟留??ъ슜?쒕떎.
func NewDistiller(store *ArtifactStore, manifest *ArtifactManifest, summarizeFn func(toolName, content string) (string, error)) *Distiller {
	return &Distiller{
		store:       store,
		manifest:    manifest,
		summarizeFn: summarizeFn,
	}
}

// Distill ? tool output???뺤텞?섍퀬 DistillResult瑜?諛섑솚?쒕떎.
// seq ??graph ?몃뱶 seq (artifact ID ?앹꽦???ъ슜).
func (d *Distiller) Distill(seq int, toolName, callID, rawOutput string, isError bool) DistillResult {
	normalized := NormalizeToolResultForContext(toolName, rawOutput)
	chars := len(normalized)

	// ?먮윭 異쒕젰??泥?臾몃떒 ??긽 蹂댁〈
	errorPrefix := ""
	if isError && chars > 0 {
		errorPrefix = extractErrorPrefix(normalized)
	}

	// FULL: threshold ?댄븯
	if chars <= FullThresholdChars {
		return DistillResult{
			InlineText: normalized,
			Projection: ProjectionFull,
		}
	}

	// FULL ?댁긽 ??artifact??raw ???	artRef, err := d.store.Save(seq, toolName, callID, normalized)
	if err != nil {
		// ????ㅽ뙣 ??PARTIAL濡?fallback
		artRef = nil
	}

	artID := ""
	artPath := ""
	if artRef != nil {
		d.manifest.Add(artRef)
		artID = artRef.ID
		artPath = artRef.Path
	}

	// PARTIAL: head+tail 異붿텧
	partialText := buildPartial(normalized, errorPrefix, artPath, PartialHeadLines, PartialTailLines)

	// SUMMARY: SummaryThreshold 珥덇낵?대㈃ ?붿빟 ?쒕룄
	if chars > SummaryThresholdChars {
		summaryText := d.tryExtractSummary(toolName, normalized, chars)
		if summaryText != "" {
			inline := fmt.Sprintf("%s\n\n--- ?꾧뎄 異쒕젰 ?붿빟 ---\n%s", partialText, summaryText)
			if errorPrefix != "" && !strings.Contains(inline, errorPrefix) {
				inline = errorPrefix + "\n\n" + inline
			}
			return DistillResult{
				InlineText:   truncateInline(inline),
				Projection:   ProjectionSummary,
				ArtifactID:   artID,
				ArtifactPath: artPath,
			}
		}
	}

	return DistillResult{
		InlineText:   truncateInline(partialText),
		Projection:   ProjectionPartial,
		ArtifactID:   artID,
		ArtifactPath: artPath,
	}
}

// tryExtractSummary ??extractive ?먮뒗 LLM ?붿빟???쒕룄?쒕떎.
func (d *Distiller) tryExtractSummary(toolName, content string, chars int) string {
	// LLM ?붿빟 ?쒕룄 (?ш린 ?쒕룄 ?댁씠怨?summarizeFn???덉쓣 ??
	if d.summarizeFn != nil && chars <= LLMSummaryMaxChars {
		if s, err := d.summarizeFn(toolName, content); err == nil && s != "" {
			return s
		}
	}
	// extractive: 泥?5以?+ 留덉?留?5以?	return extractiveSummary(content)
}

// buildPartial ? head+tail+artifact 寃쎈줈濡?援ъ꽦??PARTIAL ?띿뒪?몃? ?앹꽦?쒕떎.
func buildPartial(content, errorPrefix, artifactPath string, headLines, tailLines int) string {
	lines := strings.Split(content, "\n")
	var sb strings.Builder

	if errorPrefix != "" {
		sb.WriteString(errorPrefix)
		sb.WriteString("\n\n")
	}

	// head
	end := headLines
	if end > len(lines) {
		end = len(lines)
	}
	sb.WriteString(strings.Join(lines[:end], "\n"))

	// 以묎컙 ?앸왂 ?쒖떆
	if len(lines) > headLines+tailLines {
		omitted := len(lines) - headLines - tailLines
		sb.WriteString(fmt.Sprintf("\n... (%d以??앸왂) ...\n", omitted))

		// tail
		start := len(lines) - tailLines
		sb.WriteString(strings.Join(lines[start:], "\n"))
	}

	if artifactPath != "" {
		sb.WriteString(fmt.Sprintf("\n\n[?꾩껜 異쒕젰: %s]", artifactPath))
	}

	return sb.String()
}

// extractErrorPrefix ???먮윭 異쒕젰??泥??섎? ?덈뒗 臾몃떒??異붿텧?쒕떎.
func extractErrorPrefix(content string) string {
	lines := strings.Split(content, "\n")
	var sb strings.Builder
	for _, l := range lines {
		if strings.TrimSpace(l) == "" && sb.Len() > 0 {
			break
		}
		sb.WriteString(l)
		sb.WriteString("\n")
		if sb.Len() > 500 {
			break
		}
	}
	return strings.TrimSpace(sb.String())
}

// extractiveSummary ??content????5以?+ ??5以꾩쓣 異붿텧?쒕떎.
func extractiveSummary(content string) string {
	lines := strings.Split(strings.TrimSpace(content), "\n")
	const n = 5
	if len(lines) <= n*2 {
		return content
	}
	head := lines[:n]
	tail := lines[len(lines)-n:]
	return strings.Join(head, "\n") + "\n...\n" + strings.Join(tail, "\n")
}

// truncateInline ? inline ?띿뒪?몃? MaxInlineChars濡??먮Ⅸ??
func truncateInline(s string) string {
	if len(s) <= MaxInlineChars {
		return s
	}
	return s[:MaxInlineChars] + "\n...[truncated]"
}

